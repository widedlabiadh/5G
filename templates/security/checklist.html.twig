<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sélection du profil — Orange Tunisie</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f5f5f5;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        .container {
            background: white;
            border-radius: 12px;
            padding: 2.5rem;
            width: 500px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }
        .logo {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .logo-circle {
            width: 60px;
            height: 60px;
            background: #FF6600;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
            color: white;
        }
        h2 {
            text-align: center;
            font-size: 18px;
            font-weight: 500;
            color: #333;
            margin-bottom: 0.5rem;
        }
        .subtitle {
            text-align: center;
            font-size: 13px;
            color: #888;
            margin-bottom: 2rem;
        }
        .badge {
            display: inline-block;
            background: #fff3e0;
            color: #FF6600;
            font-size: 12px;
            font-weight: 500;
            padding: 4px 12px;
            border-radius: 20px;
            margin-bottom: 1.5rem;
        }
        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 1.5rem;
        }
        .profile-card {
            border: 1.5px solid #eee;
            border-radius: 10px;
            padding: 1.2rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            text-align: center;
        }
        .profile-card:hover {
            border-color: #FF6600;
            background: #fff8f3;
        }
        .profile-card input[type="radio"] {
            display: none;
        }
        .profile-card.selected {
            border-color: #FF6600;
            background: #fff3e0;
        }
        .profile-icon {
            font-size: 28px;
        }
        .profile-label {
            font-size: 13px;
            font-weight: 500;
            color: #333;
        }
        .btn-confirm {
            width: 100%;
            padding: 0.85rem;
            background: #FF6600;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-confirm:hover { background: #e55a00; }
        .btn-confirm:disabled {
            background: #ccc;
            cursor: not-allowed;
        }
        .logout-link {
            text-align: center;
            margin-top: 1rem;
        }
        .logout-link a {
            font-size: 13px;
            color: #888;
            text-decoration: none;
        }
        .logout-link a:hover { color: #FF6600; }
    </style>
</head>
<body>
<div class="container">
    <div class="logo">
        <div class="logo-circle">O</div>
    </div>
    <h2>Sélectionnez votre profil</h2>
    <p class="subtitle">Bienvenue — choisissez votre espace de travail</p>
    <div style="text-align:center">
        <span class="badge">{{ roleLabel }}</span>
    </div>
    <form method="post" id="checklistForm">
        <div class="profile-grid">
            {% if role == 'support_fo' %}
                <label class="profile-card" onclick="selectCard(this, 'support_fo')">
                    <input type="radio" name="profile" value="support_fo">
                    <span class="profile-icon">🔵</span>
                    <span class="profile-label">Support FO</span>
                </label>
            {% endif %}

            {% if role == 'support_fh' %}
                <label class="profile-card" onclick="selectCard(this, 'support_fh')">
                    <input type="radio" name="profile" value="support_fh">
                    <span class="profile-icon">📡</span>
                    <span class="profile-label">Support FH</span>
                </label>
            {% endif %}

            {% if role == 'ingenierie_fh' %}
                <label class="profile-card" onclick="selectCard(this, 'ingenierie_fh')">
                    <input type="radio" name="profile" value="ingenierie_fh">
                    <span class="profile-icon">⚙️</span>
                    <span class="profile-label">Ingénierie FH</span>
                </label>
            {% endif %}

            {% if role == 'ingenierie_ip' %}
                <label class="profile-card" onclick="selectCard(this, 'ingenierie_ip')">
                    <input type="radio" name="profile" value="ingenierie_ip">
                    <span class="profile-icon">🌐</span>
                    <span class="profile-label">Ingénierie IP</span>
                </label>
            {% endif %}

            {% if role == 'gc' %}
                <label class="profile-card" onclick="selectCard(this, 'gc')">
                    <input type="radio" name="profile" value="gc">
                    <span class="profile-icon">🏗️</span>
                    <span class="profile-label">Département GC</span>
                </label>
            {% endif %}

            {% if role == 'deploiement' %}
                <label class="profile-card" onclick="selectCard(this, 'deploiement')">
                    <input type="radio" name="profile" value="deploiement">
                    <span class="profile-icon">🚀</span>
                    <span class="profile-label">Déploiement</span>
                </label>
            {% endif %}
        </div>
        <button type="submit" class="btn-confirm" id="btnConfirm" disabled>
            Accéder au Dashboard →
        </button>
    </form>
    <div class="logout-link">
        <a href="{{ path('app_logout') }}">Se déconnecter</a>
    </div>
</div>
<script>
function selectCard(label, value) {
    document.querySelectorAll('.profile-card').forEach(c => c.classList.remove('selected'));
    label.classList.add('selected');
    label.querySelector('input[type="radio"]').checked = true;
    document.getElementById('btnConfirm').disabled = false;
}
</script>
</body>
</html>