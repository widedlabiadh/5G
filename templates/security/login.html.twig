<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Orange Platform | Welcome</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
</head>
<body>
<div class="login-wrapper">
    <div class="container">
        <div class="hero-grid">
           <!-- Section Welcome -->
            <div class="welcome-section">
                <div class="welcome-logo">
                    <img src="{{ asset('images/NetWON.jpeg') }}" alt="Platform Logo">
                </div>
            </div>
            <!-- Carte Login -->
            <div class="login-card">
                <div class="login-header">
                    <img class="login-orange-logo" src="{{ asset('images/orange-logo.png') }}" alt="Orange">
                    <h3>Log In</h3>
                    <p>Accédez à votre espace de travail</p>
                </div>

                {% if error %}
                    <div class="alert">
                        <i class="fas fa-exclamation-triangle"></i>
                        Email ou mot de passe incorrect.
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <input type="hidden" name="_target_path" value="{{ path('app_dashboard') }}">
                    
                    <div class="input-group">
                        <label>
                            <i class="fas fa-envelope"></i> 
                            Email
                        </label>
                        <input type="email" 
                               name="_username" 
                               id="loginEmail" 
                               placeholder="exemple@orange.tn" 
                               value="{{ last_username }}"
                               required 
                               autofocus>
                    </div>

                    <div class="input-group">
                        <label>
                            <i class="fas fa-lock"></i> 
                            Mot de passe
                        </label>
                        <input type="password" 
                               name="_password" 
                               id="loginPassword" 
                               placeholder="••••••••" 
                               required>
                    </div>

                    <button type="submit" class="btn-login">
                        <i class="fas fa-arrow-right-to-bracket"></i>
                        Se connecter
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
<script src="{{ asset('js/app.js') }}" defer></script>
</body>
</html>
