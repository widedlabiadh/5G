{% extends 'base.html.twig' %}

{% block title %}Import UMPT - NetWON{% endblock %}

{% block stylesheets %}
<style>
.umpt-page{display:flex;flex-direction:column;gap:22px}.page-header{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:8px}.page-title{font-size:30px;font-weight:800;color:#0f172a;margin:0}.page-desc{font-size:14px;color:#64748b;margin-top:6px;max-width:900px}.card{background:white;border:1px solid #e2e8f0;border-radius:16px;padding:24px;box-shadow:0 8px 24px rgba(15,23,42,.05)}.panel-title{font-size:18px;font-weight:800;color:#1e293b;margin:0 0 16px}.form-control,input[type=file]{width:100%;padding:11px 13px;border:1px solid #cbd5e1;border-radius:10px;background:white;font-size:14px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 18px;border-radius:10px;border:none;text-decoration:none;font-weight:800;font-size:13px;background:#f1f5f9;color:#334155;cursor:pointer}.btn-primary{background:#f97316;color:white}.btn-primary:hover{background:#ea580c;color:white}.form-actions{display:flex;justify-content:flex-end;margin-top:18px}.info-box{background:#fff7ed;border-left:4px solid #f97316;padding:14px 16px;border-radius:12px;color:#7c2d12;font-size:13px;margin-bottom:18px}.flash-success,.flash-error{padding:13px 16px;border-radius:12px;font-weight:700}.flash-success{background:#dcfce7;color:#166534}.flash-error{background:#fee2e2;color:#991b1b}.table-like{display:flex;flex-direction:column}.table-row{display:grid;grid-template-columns:1fr 130px 1.4fr 160px;gap:14px;align-items:center;padding:13px 0;border-bottom:1px solid #f1f5f9}.table-head{font-size:12px;text-transform:uppercase;color:#64748b;font-weight:800;background:#f8fafc;padding:12px;border-radius:10px}.badge{display:inline-block;padding:5px 11px;border-radius:999px;font-size:12px;font-weight:800}.badge.green{background:#dcfce7;color:#16a34a}.badge.red{background:#fee2e2;color:#dc2626}.empty-state{text-align:center;padding:28px 18px;background:#f8fafc;border:2px dashed #cbd5e1;border-radius:14px;color:#64748b}@media(max-width:900px){.table-row{grid-template-columns:1fr}.table-head{display:none}.page-header{align-items:flex-start;flex-direction:column}.btn{width:100%}}
</style>
{% endblock %}

{% block body %}
<div class="umpt-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">Import UMPT</h2>
            <div class="page-desc">Import initial des types de cartes UMPT par site, puis mise à jour uniquement après un swap terrain.</div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="flash-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="flash-error">{{ message }}</div>
    {% endfor %}

    <div class="card">
        <h3 class="panel-title">Charger le fichier Excel</h3>
        <div class="info-box">
            Colonnes attendues: une colonne site et une colonne UMPT/carte. Cartes reconnues: UMPTb1, UMPTb2, UMPTe1, UMPTe2, UMPTga2.
        </div>
        <form method="post" action="{{ path('import_umpt_post') }}" enctype="multipart/form-data">
            <input type="file" name="umpt_file" class="form-control" accept=".xlsx,.xls,.csv" required>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-file-import"></i> Importer UMPT
                </button>
            </div>
        </form>
    </div>

    <div class="card">
        <h3 class="panel-title">Dernières données UMPT ({{ totalUmptSites }})</h3>
        {% if umptSites is empty %}
            <div class="empty-state">Aucune donnée UMPT importée.</div>
        {% else %}
            <div class="table-like">
                <div class="table-row table-head">
                    <div>Site</div>
                    <div>Carte</div>
                    <div>Commentaire</div>
                    <div>Mise à jour</div>
                </div>
                {% for item in umptSites %}
                    <div class="table-row">
                        <div><strong>{{ item.site|clean_site }}</strong></div>
                        <div>
                            {% if item.swapRequired %}
                                <span class="badge red">{{ item.cardType }}</span>
                            {% else %}
                                <span class="badge green">{{ item.cardType }}</span>
                            {% endif %}
                        </div>
                        <div>{{ item.swapComment }}</div>
                        <div>{{ item.updatedAt|date('d/m/Y H:i') }}</div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
