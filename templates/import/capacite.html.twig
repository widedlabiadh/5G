{# templates/import/capacite.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Import Capacités - NetWON</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #f0f2f5; }
        
        .sidebar {
            width: 260px; background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
            height: 100vh; position: fixed; left: 0; top: 0;
            display: flex; flex-direction: column; padding: 1.5rem;
            z-index: 100;
        }
        .logo { display: flex; align-items: center; gap: 12px; margin-bottom: 2rem; }
        .logo-circle {
            width: 45px; height: 45px; background: linear-gradient(135deg, #f97316, #ea580c);
            border-radius: 12px; display: flex; align-items: center;
            justify-content: center; font-weight: 700; color: white; font-size: 20px;
        }
        .logo-text { color: white; font-size: 18px; font-weight: bold; }
        .logo-sub { color: #f97316; font-size: 10px; font-style: italic; }
        .nav-section {
            font-size: 11px; color: #64748b;
            text-transform: uppercase; letter-spacing: 1px;
            margin: 1.5rem 0 0.8rem;
        }
        .nav-item {
            display: flex; align-items: center; gap: 12px;
            padding: 0.7rem 1rem; border-radius: 10px;
            color: #cbd5e1; text-decoration: none; font-size: 13px;
            margin-bottom: 4px;
        }
        .nav-item:hover, .nav-item.active { background: rgba(249,115,22,0.2); color: #f97316; }
        .logout-btn {
            margin-top: auto; display: flex; align-items: center; gap: 12px;
            padding: 0.7rem 1rem; border-radius: 10px;
            color: #cbd5e1; text-decoration: none;
        }
        .logout-btn:hover { background: rgba(220,38,38,0.2); color: #ef4444; }
        
        .main { margin-left: 260px; padding: 1.5rem; }
        .topbar {
            display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 1.5rem;
        }
        .topbar h1 { font-size: 22px; font-weight: 600; color: #1e293b; }
        .user-badge {
            display: flex; align-items: center; gap: 12px;
            background: white; padding: 0.5rem 1rem;
            border-radius: 40px;
        }
        
        .grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        .card {
            background: white;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            overflow: hidden;
        }
        .card-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .card-header.fo { background: #fff7ed; border-left: 4px solid #f97316; }
        .card-header.fh { background: #eff6ff; border-left: 4px solid #3b82f6; }
        .card-header.backbone { background: #f5f3ff; border-left: 4px solid #8b5cf6; }
        .card-header h3 { font-size: 16px; font-weight: 600; }
        .card-body { padding: 1.5rem; }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 0.5rem; }
        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            font-size: 14px;
        }
        .btn {
            width: 100%;
            padding: 10px;
            border-radius: 40px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border: none;
        }
        .btn-fo { background: #f97316; color: white; }
        .btn-fh { background: #3b82f6; color: white; }
        .btn-backbone { background: #8b5cf6; color: white; }
        .btn-multiple { background: linear-gradient(135deg, #f97316, #ea580c); color: white; }
        .btn:hover { transform: translateY(-2px); }
        
        .multiple-section {
            background: white;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            padding: 1.5rem;
            margin-top: 20px;
        }
        .file-row {
            display: flex;
            gap: 15px;
            align-items: center;
            margin-bottom: 15px;
            padding: 10px;
            background: #f8fafc;
            border-radius: 12px;
        }
        .file-row select, .file-row input {
            flex: 1;
            padding: 8px 12px;
            border: 1.5px solid #e2e8f0;
            border-radius: 8px;
        }
        .btn-add {
            background: #22c55e;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
        }
        .btn-remove {
            background: #ef4444;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
        }
        .flash-success { background: #d4edda; color: #155724; padding: 12px; border-radius: 12px; margin-bottom: 1rem; }
        .flash-error { background: #f8d7da; color: #721c24; padding: 12px; border-radius: 12px; margin-bottom: 1rem; }
        .info-box {
            background: #f0fdf4;
            border-left: 4px solid #22c55e;
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 1rem;
            font-size: 13px;
        }
    </style>
</head>
<body>
<div class="sidebar">
    <div class="logo">
        <div class="logo-circle">N</div>
        <div><div class="logo-text">NetWON</div><div class="logo-sub">Import Capacité</div></div>
    </div>
    <span class="nav-section">Import</span>
    <a href="{{ path('import_excel') }}" class="nav-item">📊 Import Trafic</a>
    <a href="{{ path('import_capacite') }}" class="nav-item active">⚡ Import Capacité</a>
    <a href="{{ path('app_dashboard') }}" class="nav-item">🏠 Dashboard</a>
    <a href="{{ path('app_logout') }}" class="logout-btn">🚪 Déconnexion</a>
</div>
<div class="main">
    <div class="topbar">
        <h1>Import des capacités</h1>
        <div class="user-badge">
            <span>👤 {{ user.fullName ?? user.email }}</span>
        </div>
    </div>
    {% for msg in app.flashes('success') %}
        <div class="flash-success">{{ msg|raw }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="flash-error">{{ msg }}</div>
    {% endfor %}
    <!-- 3 CARDS POUR IMPORT SÉPARÉ -->
    <div class="grid-3">
        <!-- FO -->
        <div class="card">
            <div class="card-header fo">
                <i class="fas fa-circle" style="color: #f97316;"></i>
                <h3>📡 Fibre Optique (FO)</h3>
            </div>
            <div class="card-body">
                <form method="POST" action="{{ path('import_capacite_fo') }}" enctype="multipart/form-data">
                    <div class="form-group">
                        <input type="file" name="capacite_file" class="form-control" accept=".xlsx,.xls" required>
                    </div>
                    <button type="submit" class="btn btn-fo">
                        <i class="fas fa-upload"></i> Importer FO
                    </button>
                </form>
            </div>
        </div>
        <!-- FH -->
        <div class="card">
            <div class="card-header fh">
                <i class="fas fa-circle" style="color: #3b82f6;"></i>
                <h3>🔗 Faisceaux Hertziens (FH)</h3>
            </div>
            <div class="card-body">
                <form method="POST" action="{{ path('import_capacite_fh') }}" enctype="multipart/form-data">
                    <div class="form-group">
                        <input type="file" name="capacite_file" class="form-control" accept=".xlsx,.xls" required>
                    </div>
                    <button type="submit" class="btn btn-fh">
                        <i class="fas fa-upload"></i> Importer FH
                    </button>
                </form>
            </div>
        </div>
        <!-- BACKBONE -->
        <div class="card">
            <div class="card-header backbone">
                <i class="fas fa-circle" style="color: #8b5cf6;"></i>
                <h3>🌐 Backbone</h3>
            </div>
            <div class="card-body">
                <form method="POST" action="{{ path('import_capacite_backbone') }}" enctype="multipart/form-data">
                    <div class="form-group">
                        <input type="file" name="capacite_file" class="form-control" accept=".xlsx,.xls" required>
                    </div>
                    <button type="submit" class="btn btn-backbone">
                        <i class="fas fa-upload"></i> Importer Backbone
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    function addRow() {
        const container = document.getElementById('filesContainer');
        const rows = container.getElementsByClassName('file-row');
        if (rows.length >= 3) {
            alert('Vous ne pouvez ajouter que 3 fichiers maximum');
            return;
        }
        const newRow = document.createElement('div');
        newRow.className = 'file-row';
        newRow.innerHTML = `
            <select name="types[]" required>
                <option value="">Type</option>
                <option value="FO">FO - Fibre Optique</option>
                <option value="FH">FH - Faisceau Hertzien</option>
                <option value="BACKBONE">BACKBONE - Backbone</option>
            </select>
            <input type="file" name="capacite_files[]" accept=".xlsx,.xls" required>
            <button type="button" class="btn-remove" onclick="removeRow(this)">🗑️</button>
        `;
        container.appendChild(newRow);
        
        // Afficher les boutons supprimer sur toutes les lignes
        const allRemoveBtns = document.querySelectorAll('.btn-remove');
        allRemoveBtns.forEach(btn => btn.style.display = 'inline-block');
    }
    
    function removeRow(btn) {
        const row = btn.parentElement;
        const container = document.getElementById('filesContainer');
        if (container.children.length > 1) {
            row.remove();
        }
        
        // Si plus qu'une ligne, cacher le bouton supprimer de la première
        const remainingRows = document.querySelectorAll('.file-row');
        if (remainingRows.length === 1) {
            remainingRows[0].querySelector('.btn-remove').style.display = 'none';
        }
    }
    
    // Initialisation
    document.addEventListener('DOMContentLoaded', function() {
        const firstRow = document.querySelector('.file-row');
        if (firstRow) {
            const firstRemoveBtn = firstRow.querySelector('.btn-remove');
            if (firstRemoveBtn) firstRemoveBtn.style.display = 'none';
        }
    });
</script>
</body>
</html>