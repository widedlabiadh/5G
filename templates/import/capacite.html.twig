{% extends 'base.html.twig' %}
{% block title %}Import Capacités — NetWON{% endblock %}

{% block stylesheets %}
<style>
/* ═══ CAPACITE IMPORT PAGE ═══ */
.cap-page {
  padding: 32px 28px 60px;
}

/* ── Topbar ── */
.cap-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
  flex-wrap: wrap;
  gap: 12px;
}
.cap-topbar-left h1 {
  font-family: 'Syne', sans-serif;
  font-size: 1.45rem;
  font-weight: 800;
  color: var(--txt);
  letter-spacing: -.4px;
  margin: 0 0 3px;
}
.cap-topbar-left p {
  font-size: 0.78rem;
  color: var(--txt-3);
  margin: 0;
}

/* ── TYPE GRID ── */
.cap-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 32px;
}

/* ── CARDS ── */
.cap-card {
  background: var(--white);
  border: 2px solid var(--border);
  border-radius: 20px;
  overflow: hidden;
  transition: box-shadow .22s ease, transform .22s ease;
}
.cap-card:hover {
  box-shadow: 0 8px 28px rgba(0,0,0,0.08);
  transform: translateY(-2px);
}
.cap-card-header {
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 10px;
}
.cap-card-header.fo  { background: #fff7ed; border-left: 4px solid #f97316; }
.cap-card-header.fh  { background: #eff6ff; border-left: 4px solid #3b82f6; }
.cap-card-header.bb  { background: #f5f3ff; border-left: 4px solid #8b5cf6; }
.cap-card-header h3 {
  font-family: 'Syne', sans-serif;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--txt);
  margin: 0;
}
.cap-card-body { padding: 1.5rem; }

/* ── UPLOAD ZONE ── */
.ufile-cap {
  display: flex;
  align-items: center;
  gap: 14px;
  background: var(--bg, #f8fafc);
  border: 1.5px dashed var(--border);
  border-radius: 14px;
  padding: 14px 18px;
  cursor: pointer;
  transition: border-color .2s, background .2s;
  position: relative;
  overflow: hidden;
  margin-bottom: 1rem;
}
.ufile-cap:hover {
  border-color: var(--orange-border, #fdba74);
  background: var(--orange-pale, #fff7ed);
}
.ufile-cap.has-file {
  border-color: #10b981;
  background: #f0fdf6;
  border-style: solid;
}
.ufile-cap input[type=file] {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}
.ufile-cap.has-file input[type=file] { pointer-events: none; }
.ufile-cap-icon {
  width: 40px; height: 40px;
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem; flex-shrink: 0;
}
.ufile-cap-meta { flex: 1; min-width: 0; }
.ufile-cap-label {
  font-size: 0.7rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .7px;
  color: var(--txt-3); margin-bottom: 2px;
}
.ufile-cap-name {
  font-size: 0.82rem; font-weight: 600; color: var(--txt);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ufile-cap-name.placeholder { color: var(--txt-3); font-weight: 400; }

/* ── SUBMIT BUTTON ── */
.btn-cap-submit {
  width: 100%;
  padding: 11px 18px;
  border-radius: 30px;
  font-size: 0.82rem; font-weight: 700;
  cursor: pointer; border: none;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  transition: all .22s ease;
  font-family: 'DM Sans', sans-serif;
}
.btn-cap-submit.fo     { background: #f97316; color: white; box-shadow: 0 4px 14px rgba(249,115,22,.25); }
.btn-cap-submit.fh     { background: #3b82f6; color: white; box-shadow: 0 4px 14px rgba(59,130,246,.25); }
.btn-cap-submit.bb     { background: #8b5cf6; color: white; box-shadow: 0 4px 14px rgba(139,92,246,.25); }
.btn-cap-submit:hover:not(:disabled) { transform: translateY(-2px); filter: brightness(1.08); }
.btn-cap-submit:disabled { opacity: .5; cursor: not-allowed; transform: none; }

/* ── BACK LINK ── */
.back-link {
  font-size: .78rem;
  color: var(--txt-3);
  text-decoration: none;
  display: flex; align-items: center; gap: 6px;
  transition: color .15s;
}
.back-link:hover { color: var(--orange); }

/* ── INFO NOTE ── */
.cap-note {
  display: flex; align-items: flex-start; gap: 8px;
  background: var(--bg, #f8fafc);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 0.72rem; color: var(--txt-3);
  margin-bottom: 1rem;
}
.cap-note i { color: var(--orange); flex-shrink: 0; margin-top: 1px; }

/* Flash */
.flash-cap { padding: 10px 14px; border-radius: 10px; margin-bottom: 18px; font-size: 0.82rem; font-weight: 500; display: flex; align-items: center; gap: 8px; }
.flash-cap.s { background: #d1fae5; border: 1px solid #a7f3d0; color: #065f46; }
.flash-cap.e { background: #fee2e2; border: 1px solid #fecaca; color: #991b1b; }

/* Responsive */
@media (max-width: 900px) {
  .cap-grid { grid-template-columns: 1fr; }
}
</style>
{% endblock %}

{% block body %}
<div class="cap-page">

  {# ── Topbar ── #}
  <div class="cap-topbar">
    <div class="cap-topbar-left">
      <h1>Import <span style="color:var(--orange)">Capacités</span></h1>
      <p>Importez les fichiers de capacité FO, FH et Backhaul Sharing</p>
    </div>
    <a href="{{ path('app_dashboard') }}" class="back-link">
      <i class="fas fa-arrow-left" style="font-size:.7rem;"></i> Dashboard
    </a>
  </div>

  {# Flash messages #}
  {% for msg in app.flashes('success') %}
    <div class="flash-cap s"><i class="fas fa-circle-check"></i> {{ msg|raw }}</div>
  {% endfor %}
  {% for msg in app.flashes('error') %}
    <div class="flash-cap e"><i class="fas fa-circle-xmark"></i> {{ msg }}</div>
  {% endfor %}

  <div class="cap-note">
    <i class="fas fa-circle-info"></i>
    <span>Les fichiers acceptés sont au format <strong>.xlsx</strong> ou <strong>.xls</strong>. Chaque import met à jour les seuils de capacité correspondants dans la base de données.</span>
  </div>

  {# ── 3 CARDS ── #}
  <div class="cap-grid">

    {# FO #}
    <div class="cap-card">
      <div class="cap-card-header fo">
        <i class="fas fa-circle-dot" style="color:#f97316;"></i>
        <h3>📡 Fibre Optique (FO)</h3>
      </div>
      <div class="cap-card-body">
        <form method="POST" action="{{ path('import_capacite_fo') }}" enctype="multipart/form-data" id="form-fo">
          <div class="ufile-cap" id="zone-fo">
            <input type="file" name="capacite_file" accept=".xlsx,.xls" required data-zone="fo">
            <div class="ufile-cap-icon" style="background:#fff7ed;">
              <i class="fas fa-file-excel" style="color:#f97316;"></i>
            </div>
            <div class="ufile-cap-meta">
              <div class="ufile-cap-label">Fichier capacité FO</div>
              <div class="ufile-cap-name placeholder" id="name-fo">Aucun fichier sélectionné</div>
            </div>
            <i class="fas fa-folder-open" style="color:var(--txt-3);font-size:.85rem;flex-shrink:0;"></i>
          </div>
          <button type="submit" class="btn-cap-submit fo" id="btn-fo" disabled>
            <i class="fas fa-arrow-up-from-bracket"></i> Importer FO
          </button>
        </form>
      </div>
    </div>

    {# FH #}
    <div class="cap-card">
      <div class="cap-card-header fh">
        <i class="fas fa-circle-dot" style="color:#3b82f6;"></i>
        <h3>🔗 Faisceaux Hertziens (FH)</h3>
      </div>
      <div class="cap-card-body">
        <form method="POST" action="{{ path('import_capacite_fh') }}" enctype="multipart/form-data" id="form-fh">
          <div class="ufile-cap" id="zone-fh">
            <input type="file" name="capacite_file" accept=".xlsx,.xls" required data-zone="fh">
            <div class="ufile-cap-icon" style="background:#eff6ff;">
              <i class="fas fa-file-excel" style="color:#3b82f6;"></i>
            </div>
            <div class="ufile-cap-meta">
              <div class="ufile-cap-label">Fichier capacité FH</div>
              <div class="ufile-cap-name placeholder" id="name-fh">Aucun fichier sélectionné</div>
            </div>
            <i class="fas fa-folder-open" style="color:var(--txt-3);font-size:.85rem;flex-shrink:0;"></i>
          </div>
          <button type="submit" class="btn-cap-submit fh" id="btn-fh" disabled>
            <i class="fas fa-arrow-up-from-bracket"></i> Importer FH
          </button>
        </form>
      </div>
    </div>

    {# BACKHAUL SHARING #}
    <div class="cap-card">
      <div class="cap-card-header bb">
        <i class="fas fa-circle-dot" style="color:#8b5cf6;"></i>
        <h3>🌐 Backhaul Sharing</h3>
      </div>
      <div class="cap-card-body">
        <form method="POST" action="{{ path('import_capacite_backbone') }}" enctype="multipart/form-data" id="form-bb">
          <div class="ufile-cap" id="zone-bb">
            <input type="file" name="capacite_file" accept=".xlsx,.xls" required data-zone="bb">
            <div class="ufile-cap-icon" style="background:#f5f3ff;">
              <i class="fas fa-file-excel" style="color:#8b5cf6;"></i>
            </div>
            <div class="ufile-cap-meta">
              <div class="ufile-cap-label">Fichier capacité Backhaul Sharing</div>
              <div class="ufile-cap-name placeholder" id="name-bb">Aucun fichier sélectionné</div>
            </div>
            <i class="fas fa-folder-open" style="color:var(--txt-3);font-size:.85rem;flex-shrink:0;"></i>
          </div>
          <button type="submit" class="btn-cap-submit bb" id="btn-bb" disabled>
            <i class="fas fa-arrow-up-from-bracket"></i> Importer Backhaul Sharing
          </button>
        </form>
      </div>
    </div>

  </div>{# .cap-grid #}

</div>{# .cap-page #}
{% endblock %}

{% block javascripts %}
<script>
(function () {
  ['fo', 'fh', 'bb'].forEach(function (zone) {
    const zoneEl = document.getElementById('zone-' + zone);
    const nameEl = document.getElementById('name-' + zone);
    const btnEl  = document.getElementById('btn-' + zone);
    const input  = zoneEl.querySelector('input[type=file]');

    function onFile(file) {
      if (!file) return;
      var ext = file.name.split('.').pop().toLowerCase();
      if (!['xlsx', 'xls'].includes(ext)) {
        alert('Fichier Excel requis (.xlsx ou .xls)');
        return;
      }
      nameEl.textContent = file.name;
      nameEl.classList.remove('placeholder');
      zoneEl.classList.add('has-file');
      btnEl.disabled = false;
    }

    input.addEventListener('change', function (e) {
      if (e.target.files[0]) onFile(e.target.files[0]);
    });

    zoneEl.addEventListener('dragover', function (e) {
      e.preventDefault();
      zoneEl.style.borderColor = 'var(--orange)';
      zoneEl.style.background  = 'var(--orange-pale, #fff7ed)';
    });
    zoneEl.addEventListener('dragleave', function () {
      if (!zoneEl.classList.contains('has-file')) {
        zoneEl.style.borderColor = '';
        zoneEl.style.background  = '';
      }
    });
    zoneEl.addEventListener('drop', function (e) {
      e.preventDefault();
      zoneEl.style.borderColor = '';
      zoneEl.style.background  = '';
      if (e.dataTransfer.files[0]) onFile(e.dataTransfer.files[0]);
    });
  });
})();
</script>
{% endblock %}
