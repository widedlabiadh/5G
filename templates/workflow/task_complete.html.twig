{% extends 'base.html.twig' %}

{% block title %}Terminer la tâche - NetWON{% endblock %}

{% block stylesheets %}
<style>
.task-container{max-width:900px;margin:0 auto}.task-header-banner{background:linear-gradient(135deg,#3b82f6 0%,#2563eb 100%);color:white;padding:30px;border-radius:12px;margin-bottom:30px;box-shadow:0 4px 15px rgba(59,130,244,.2)}.task-title-main{font-size:28px;font-weight:700;margin:0 0 10px}.task-meta-info{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:15px;margin-top:20px}.meta-badge{background:rgba(255,255,255,.2);padding:12px;border-radius:8px;font-size:14px}.meta-label{display:block;font-size:12px;opacity:.9;margin-bottom:4px}.meta-value{font-weight:600;font-size:16px}.task-details-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:30px}.task-section,.form-section{background:white;border:1px solid #e2e8f0;border-radius:12px;padding:20px;margin-bottom:30px}.section-title{font-weight:600;color:#1e293b;margin-bottom:15px;font-size:16px;display:flex;align-items:center;gap:10px}.info-row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f1f5f9;font-size:14px}.info-row:last-child{border-bottom:none}.info-label{color:#64748b;font-weight:500}.info-value{color:#0f172a;font-weight:600}.form-group{margin-bottom:20px}.form-label,label{display:block;font-weight:600;color:#1e293b;margin-bottom:8px;font-size:14px}.form-control,textarea,input[type=file]{width:100%;padding:10px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:14px;font-family:inherit}textarea{resize:vertical;min-height:120px}.button-group{display:flex;gap:12px;justify-content:flex-end;margin-top:30px}.btn{padding:12px 24px;border-radius:8px;font-weight:600;border:none;cursor:pointer;font-size:14px;text-decoration:none}.btn-success{background:#10b981;color:white}.btn-secondary{background:#94a3b8;color:white}.alert-info{background:#dbeafe;color:#0c4a6e;border-left:4px solid #3b82f6;padding:15px;border-radius:8px;margin-bottom:20px}@media(max-width:768px){.task-details-grid{grid-template-columns:1fr}.button-group{flex-direction:column}.btn{width:100%;text-align:center}}
</style>
{% endblock %}

{% block body %}
<div class="task-container">
    <div class="task-header-banner">
        <div class="task-title-main">✅ Terminer la tâche</div>
        <div class="task-meta-info">
            <div class="meta-badge"><span class="meta-label">Titre</span><span class="meta-value">{{ task.title }}</span></div>
            <div class="meta-badge"><span class="meta-label">Ticket</span><span class="meta-value">#{{ task.ticket.id }}</span></div>
            <div class="meta-badge"><span class="meta-label">Étape</span><span class="meta-value">{{ task.stepCode ? task.stepCode|upper|replace({'_': ' '}) : 'TRAITEMENT' }}</span></div>
        </div>
    </div>

    <div class="task-details-grid">
        <div class="task-section">
            <div class="section-title">Détails de la tâche</div>
            <div class="info-row"><span class="info-label">Statut</span><span class="info-value">{{ task.status|upper }}</span></div>
            <div class="info-row"><span class="info-label">Assigné à</span><span class="info-value">{{ task.assignedTo.fullName ?? task.assignedTo.email }}</span></div>
            {% if task.startedAt %}<div class="info-row"><span class="info-label">Démarrée le</span><span class="info-value">{{ task.startedAt|date('d/m/Y H:i') }}</span></div>{% endif %}
        </div>
        <div class="task-section">
            <div class="section-title">Infos du ticket</div>
            <div class="info-row"><span class="info-label">Titre</span><span class="info-value">{{ task.ticket.title }}</span></div>
            <div class="info-row"><span class="info-label">Progression</span><span class="info-value">{{ task.ticket.progress }}%</span></div>
            <div class="info-row"><span class="info-label">Site</span><span class="info-value">{{ task.ticket.site ? task.ticket.site.site : '-' }}</span></div>
            <div class="info-row"><span class="info-label">Créé le</span><span class="info-value">{{ task.ticket.createdAt|date('d/m/Y') }}</span></div>
        </div>
    </div>

    {% if task.description %}
        <div class="task-section"><div class="section-title">Description</div><p style="color:#475569;line-height:1.6;">{{ task.description }}</p></div>
    {% endif %}

    <div class="form-section">
        <div class="section-title">✏️ Valider la tâche</div>
        <div class="alert-info"><strong>Info:</strong> Remplissez ce formulaire pour marquer la tâche comme complétée.</div>
        <form method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label>Commentaire / Résultat</label>
                <textarea name="comment" class="form-control" placeholder="Décrivez l'action réalisée, les résultats, les blocages éventuels..."></textarea>
            </div>
            <div class="form-group">
                <label>Pièce jointe / Preuve</label>
                <input type="file" name="proofFile" class="form-control">
            </div>
            <div class="button-group">
                <a href="{{ path('team_workflow_index') }}" class="btn btn-secondary">← Annuler</a>
                <button type="submit" class="btn btn-success">✓ Valider et continuer</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
