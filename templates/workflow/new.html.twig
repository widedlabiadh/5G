{% extends 'base.html.twig' %}

{% block title %}Créer un workflow - NetWON{% endblock %}

{% block stylesheets %}
<style>
.workflow-page{display:flex;flex-direction:column;gap:22px}.page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.page-title{font-size:30px;font-weight:800;color:#0f172a;margin:0}.page-desc{font-size:14px;color:#64748b;margin-top:6px;max-width:900px}.card{background:white;border:1px solid #e2e8f0;border-radius:16px;padding:24px;box-shadow:0 8px 24px rgba(15,23,42,.05)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.full-width{grid-column:1/-1}label{display:block;font-weight:800;color:#1e293b;margin-bottom:8px;font-size:14px}.form-control,input[type=text],input[type=date],select,textarea{width:100%;padding:11px 13px;border:1px solid #cbd5e1;border-radius:10px;background:white;font-size:14px}.form-control:focus,input:focus,select:focus,textarea:focus{outline:none;border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.12)}textarea{min-height:120px;resize:vertical}.workflow-select-box{height:260px;max-height:260px;overflow-y:auto;border:1px solid #d7dde8;border-radius:16px;background:#fff;padding:10px;margin-top:10px}.workflow-check-row{display:flex;align-items:flex-start;gap:12px;padding:10px 12px;border-radius:12px;cursor:pointer;font-size:15px}.workflow-check-row:hover{background:#fff7ed}.workflow-check-row input{width:17px;height:17px;margin-top:3px}.workflow-check-row span{display:flex;flex-direction:column;gap:3px}.workflow-check-row small{color:#64748b;font-size:13px}.muted{font-size:12px;color:#64748b;margin-top:7px;display:block}.form-actions{display:flex;gap:12px;justify-content:flex-end;margin-top:24px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 18px;border-radius:10px;border:none;text-decoration:none;font-weight:800;font-size:13px;background:#f1f5f9;color:#334155;cursor:pointer}.btn-primary{background:#3b82f6;color:white}.btn-primary:hover{background:#2563eb;color:white}.flash-error{padding:13px 16px;border-radius:12px;background:#fee2e2;color:#991b1b;font-weight:700}@media(max-width:800px){.form-grid{grid-template-columns:1fr}.form-actions{flex-direction:column}.btn{width:100%}}
.workflow-select-tools{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:10px}.workflow-select-actions{display:flex;gap:8px}.workflow-selected-count{font-size:12px;color:#64748b;font-weight:800}.btn-sm{padding:7px 11px;font-size:12px}.btn:hover{background:#e2e8f0;color:#334155}.curve-link{display:inline-flex;align-items:center;gap:6px;width:max-content;margin-top:4px;color:#2563eb;text-decoration:none;font-size:12px;font-weight:800}.curve-link:hover{text-decoration:underline}.critical-count{display:inline-flex;align-items:center;gap:8px;margin-top:10px;padding:8px 11px;border-radius:999px;background:#fee2e2;color:#991b1b;font-size:12px;font-weight:800}.empty-state{padding:18px;border:2px dashed #cbd5e1;border-radius:12px;color:#64748b;background:#f8fafc;text-align:center}@media(max-width:800px){.workflow-select-tools{flex-direction:column;align-items:stretch}.workflow-select-actions{flex-direction:column}}
</style>
{% endblock %}

{% block body %}
<div class="workflow-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">Créer un workflow</h2>
            <div class="page-desc">Choisissez les sites critiques à traiter. Les utilisateurs seront automatiquement assignés selon les services requis (FO, IP, Déploiement, Radio, etc.).</div>
            <div class="critical-count">{{ availableSites|length }} site(s) critique(s)</div>
        </div>
    </div>

    {% for message in app.flashes('error') %}
        <div class="flash-error">{{ message }}</div>
    {% endfor %}

    <div class="card">
        {{ form_start(form) }}

        <div class="form-grid">
            <div>
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>

            <div>
                {{ form_label(form.actionType) }}
                {{ form_widget(form.actionType) }}
                {{ form_errors(form.actionType) }}
            </div>

            <div>
                {{ form_label(form.deadlineAt) }}
                {{ form_widget(form.deadlineAt) }}
                {{ form_errors(form.deadlineAt) }}
            </div>

            <div class="full-width">
                <label>Sites critiques concernés</label>
                <input type="text" id="siteSearch" class="form-control" placeholder="Rechercher un site...">
                <div class="workflow-select-tools">
                    <div class="workflow-selected-count" id="selectedSiteCount">0 site sélectionné</div>
                    <div class="workflow-select-actions">
                        <button type="button" class="btn btn-sm" id="selectAllSites">Select All</button>
                        <button type="button" class="btn btn-sm" id="clearAllSites">Désélectionner</button>
                    </div>
                </div>

                <div class="workflow-select-box" id="siteList">
                    {% for site in availableSites %}
                        <label class="workflow-check-row">
                            <input type="checkbox" name="site_ids[]" value="{{ site.id }}">
                            <span>
                                <strong>{{ site.site|clean_site }}</strong>
                                <small>{{ site.typeTrans ?: '-' }} | Trafic {{ site.maxTrafic ?: '-' }} | Occurrences {{ site.nombreOccurrences ?: 0 }} | Seuil {{ site.seuilCritique ?: '-' }}</small>
                                <small>UMPT: {{ site.umptType ?: 'non importé' }}{% if site.swapComment is defined and site.swapComment %} | {{ site.swapComment }}{% endif %}</small>
                                <a class="curve-link" href="{{ path('courbe_trafic', {site: site.site}) }}" onclick="event.stopPropagation();">
                                    <i class="fas fa-chart-line"></i> Voir courbe
                                </a>
                            </span>
                        </label>
                    {% else %}
                        <div class="empty-state">Aucun site critique disponible pour la dernière analyse.</div>
                    {% endfor %}
                </div>

                <small class="muted">Cochez un ou plusieurs sites critiques. Le lien “Voir courbe” ouvre la courbe trafic du site.</small>
            </div>

            <div class="full-width">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>
        </div>

        <div class="form-actions">
            <a href="{{ path('workflow_index') }}" class="btn">Retour</a>
            <button type="submit" class="btn btn-primary">Créer le workflow (auto-assign)</button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
function filterRows(inputId, listId) {
    const input = document.getElementById(inputId);
    const list = document.getElementById(listId);
    if (!input || !list) return;
    input.addEventListener('input', function () {
        const q = input.value.toLowerCase();
        list.querySelectorAll('.workflow-check-row').forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(q) ? 'flex' : 'none';
        });
    });
}
filterRows('siteSearch', 'siteList');

const siteList = document.getElementById('siteList');
const selectedSiteCount = document.getElementById('selectedSiteCount');
const selectAllSites = document.getElementById('selectAllSites');
const clearAllSites = document.getElementById('clearAllSites');

function visibleSiteCheckboxes() {
    if (!siteList) return [];
    return Array.from(siteList.querySelectorAll('.workflow-check-row'))
        .filter(row => row.style.display !== 'none')
        .map(row => row.querySelector('input[type="checkbox"]'))
        .filter(Boolean);
}

function updateSelectedSiteCount() {
    if (!siteList || !selectedSiteCount) return;
    const count = siteList.querySelectorAll('input[type="checkbox"]:checked').length;
    selectedSiteCount.textContent = count + (count > 1 ? ' sites sélectionnés' : ' site sélectionné');
}

if (selectAllSites) {
    selectAllSites.addEventListener('click', function () {
        visibleSiteCheckboxes().forEach(checkbox => checkbox.checked = true);
        updateSelectedSiteCount();
    });
}

if (clearAllSites) {
    clearAllSites.addEventListener('click', function () {
        siteList.querySelectorAll('input[type="checkbox"]').forEach(checkbox => checkbox.checked = false);
        updateSelectedSiteCount();
    });
}

if (siteList) {
    siteList.addEventListener('change', updateSelectedSiteCount);
    updateSelectedSiteCount();
}
</script>
{% endblock %}
