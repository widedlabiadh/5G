{% extends 'base.html.twig' %}

{% block title %}Ticket #{{ ticket.id }} - NetWON{% endblock %}

{% block stylesheets %}
<style>
.page-header{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:22px}.page-title{font-size:30px;font-weight:800;color:#0f172a;margin:0}.page-desc{font-size:14px;color:#64748b;margin-top:7px;max-width:900px}.card{background:white;border:1px solid #e2e8f0;border-radius:16px;padding:22px;margin-bottom:22px;box-shadow:0 8px 24px rgba(15,23,42,.05)}.panel-title{font-size:18px;font-weight:800;color:#1e293b;margin:0 0 16px}.table-like{display:flex;flex-direction:column}.table-row{display:grid;grid-template-columns:1.2fr 1.5fr 1fr 1fr;gap:14px;align-items:center;padding:13px 0;border-bottom:1px solid #f1f5f9}.site-table-row{grid-template-columns:1.1fr .8fr .9fr .8fr .8fr 1.5fr}.table-row:last-child{border-bottom:none}.table-head{font-size:12px;text-transform:uppercase;color:#64748b;font-weight:800;background:#f8fafc;padding:12px;border-radius:10px}.muted{font-size:12px;color:#64748b;margin-top:4px}.empty-state{text-align:center;padding:28px 18px;background:#f8fafc;border:2px dashed #cbd5e1;border-radius:14px;color:#64748b}.badge{display:inline-block;padding:5px 11px;border-radius:999px;font-size:12px;font-weight:800}.badge.mauve{background:#ede9fe;color:#7c3aed}.badge.blue{background:#dbeafe;color:#2563eb}.badge.green{background:#dcfce7;color:#16a34a}.badge.red{background:#fee2e2;color:#dc2626}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:9px 14px;border-radius:10px;border:none;text-decoration:none;font-weight:800;font-size:12px;background:#f1f5f9;color:#334155;cursor:pointer}.btn-primary{background:#3b82f6;color:white}.btn-success{background:#10b981;color:white}.btn-sm{padding:7px 11px}.form-control,textarea,input[type=file]{width:100%;padding:11px 13px;border:1px solid #cbd5e1;border-radius:10px;background:white;font-size:14px}textarea{min-height:100px;resize:vertical}.comment-form{display:grid;gap:12px;margin-top:18px}.progress-bar{height:10px;background:#e2e8f0;border-radius:999px;overflow:hidden}.progress-fill{height:100%;background:#3b82f6;border-radius:999px}@media(max-width:900px){.table-row,.site-table-row{grid-template-columns:1fr}.page-header{flex-direction:column}.btn{width:100%}}
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h2 class="page-title">{{ ticket.title }}</h2>
        <div class="page-desc">{{ ticket.description ?: 'Aucune description.' }}</div>
    </div>
</div>

<div class="card">
    <h3 class="panel-title">Informations générales</h3>
    <div class="table-like">
        <div class="table-row">
            <div><strong>Action</strong></div>
            <div>{{ ticket.actionTypeLabel|raw }}</div>
        </div>
        <div class="table-row">
            <div><strong>Statut</strong></div>
            <div>
                {% if ticket.status == 'open' %}
                    <span class="badge mauve">Ouvert</span>
                {% elseif ticket.status == 'in_progress' %}
                    <span class="badge blue">En cours</span>
                {% elseif ticket.status == 'pending_validation' %}
                    <span class="badge green">En validation</span>
                {% elseif ticket.status == 'closed' %}
                    <span class="badge green">Clôturé</span>
                {% else %}
                    <span class="badge red">{{ ticket.status }}</span>
                {% endif %}
            </div>
        </div>
        <div class="table-row">
            <div><strong>Progression</strong></div>
            <div>
                {{ ticket.progress }}%
                <div class="progress-bar"><div class="progress-fill" style="width:{{ ticket.progress }}%"></div></div>
            </div>
        </div>
        <div class="table-row">
            <div><strong>Bloqué chez</strong></div>
            <div>
                {% set blocker = null %}
                {% for task in ticket.tasks %}
                    {% if blocker is null and task.status != 'done' %}
                        {% set blocker = task.assignedTo.fullName ?? task.assignedTo.email %}
                    {% endif %}
                {% endfor %}
                {% if blocker %}
                    <span class="badge red">{{ blocker }}</span>
                {% else %}
                    <span class="badge green">Aucun blocage</span>
                {% endif %}
            </div>
        </div>
        <div class="table-row">
            <div><strong>Date limite</strong></div>
            <div>{{ ticket.deadlineAt ? ticket.deadlineAt|date('d/m/Y H:i') : '-' }}</div>
        </div>
        <div class="table-row">
            <div><strong>Créé par</strong></div>
            <div>{{ ticket.createdBy.fullName ?? ticket.createdBy.email ?? 'Utilisateur' }}</div>
        </div>
    </div>
</div>

<div class="card">
    <h3 class="panel-title">Sites concernés</h3>
    {% if ticket.ticketSites is empty and ticket.site is empty %}
        <div class="empty-state">Aucun site lié.</div>
    {% else %}
        <div class="table-like">
            <div class="table-row table-head site-table-row"><div>Site</div><div>Type Trans</div><div>Classification</div><div>Trafic max</div><div>Carte UMPT</div><div>Commentaire IP</div></div>
            {% if ticket.ticketSites is not empty %}
                {% for ticketSite in ticket.ticketSites %}
                    <div class="table-row site-table-row">
                        <div><strong>{{ ticketSite.siteName|clean_site }}</strong></div>
                        <div>{{ ticketSite.typeTrans ?: '-' }}</div>
                        <div>{{ ticketSite.serviceName ?: '-' }}</div>
                        <div>{{ ticketSite.maxTrafic ?: '-' }}</div>
                        <div>
                            {% if ticketSite.umptType %}
                                {% if ticketSite.swapRequired %}
                                    <span class="badge red">{{ ticketSite.umptType }}</span>
                                {% else %}
                                    <span class="badge green">{{ ticketSite.umptType }}</span>
                                {% endif %}
                            {% else %}
                                -
                            {% endif %}
                        </div>
                        <div>{{ ticketSite.swapComment ?: '-' }}</div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="table-row site-table-row">
                    <div><strong>{{ ticket.site.site|clean_site }}</strong></div>
                    <div>{{ ticket.site.typeTrans ?: '-' }}</div>
                    <div>{{ ticket.site.classification ?: '-' }}</div>
                    <div>{{ ticket.site.maxTrafic ?: '-' }}</div>
                    <div>-</div>
                    <div>-</div>
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>

<div class="card">
    <h3 class="panel-title">Tâches</h3>
    {% if ticket.tasks is empty %}
        <div class="empty-state">Aucune tâche.</div>
    {% else %}
        <div class="table-like">
            {% for task in ticket.tasks %}
                <div class="table-row">
                    <div>
                        <strong>{{ task.assignedTo.fullName ?? task.assignedTo.email }}</strong>
                        <div>{{ task.title }}</div>
                        <div class="muted">{{ task.description ?: '-' }}</div>
                    </div>
                    <div>
                        {% if task.status == 'pending' %}
                            <span class="badge mauve">En attente</span>
                        {% elseif task.status == 'in_progress' %}
                            <span class="badge blue">En cours</span>
                        {% elseif task.status == 'done' %}
                            <span class="badge green">Terminée</span>
                        {% elseif task.status == 'blocked' %}
                            <span class="badge red">Bloquée</span>
                        {% else %}
                            <span class="badge red">{{ task.status }}</span>
                        {% endif %}
                    </div>
                    <div>{{ task.stepCode ? task.stepCode|replace({'_': ' '}) : '-' }}</div>
                    <div>
                        {% if app.user and app.user.id == task.assignedTo.id %}
                            {% if task.status == 'pending' %}
                                <form method="post" action="{{ path('workflow_task_start', {id: task.id}) }}" style="margin-bottom:8px;">
                                    <button type="submit" class="btn btn-primary btn-sm">Démarrer</button>
                                </form>
                            {% endif %}
                            {% if task.status != 'done' %}
                                <a href="{{ path('team_workflow_task_show', {id: task.id}) }}" class="btn btn-success btn-sm">Terminer</a>
                            {% else %}
                                <span class="badge green">Terminée</span>
                            {% endif %}
                        {% else %}
                            -
                        {% endif %}
                    </div>
                </div>
                {% if task.comment or task.proofFile %}
                    <div class="table-row">
                        <div><strong>Preuve</strong></div>
                        <div>
                            <div>{{ task.comment ?: '-' }}</div>
                            {% if task.proofFile %}
                                <a href="{{ asset('uploads/ticket_proofs/' ~ task.proofFile) }}" target="_blank">Voir fichier</a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
</div>

<div class="card">
    <h3 class="panel-title">Commentaires</h3>
    {% if ticket.comments is empty %}
        <div class="empty-state">Aucun commentaire.</div>
    {% else %}
        <div class="table-like">
            {% for comment in ticket.comments %}
                <div class="table-row">
                    <div>
                        <strong>{{ comment.user.fullName ?? comment.user.email }}</strong>
                        <div class="muted">{{ comment.createdAt|date('d/m/Y H:i') }}</div>
                    </div>
                    <div>{{ comment.message }}</div>
                    <div>
                        {% if comment.filePath %}
                            <a href="{{ asset('uploads/ticket_comments/' ~ comment.filePath) }}" target="_blank">Pièce jointe</a>
                        {% else %}
                            -
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <form method="post" action="{{ path('workflow_comment_add', {id: ticket.id}) }}" enctype="multipart/form-data" class="comment-form">
        <textarea name="message" class="form-control" placeholder="Ajouter un commentaire..."></textarea>
        <input type="file" name="filePath" class="form-control">
        <button class="btn btn-primary">Ajouter commentaire</button>
    </form>
</div>

<div class="card">
    <h3 class="panel-title">Historique</h3>
    {% if ticket.history is empty %}
        <div class="empty-state">Aucun historique.</div>
    {% else %}
        <div class="table-like">
            {% for item in ticket.history %}
                <div class="table-row">
                    <div>{{ item.createdAt|date('d/m/Y H:i') }}</div>
                    <div>{{ item.action }}</div>
                    <div>{{ item.details ?: '-' }}</div>
                    <div>{{ item.user ? (item.user.fullName ?? item.user.email) : 'Système' }}</div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

{% if ticket.progress == 100 and ticket.status != 'closed' and app.user.role in ['superuser', 'admin'] %}
<div class="card">
    <form method="post" action="{{ path('workflow_close', {id: ticket.id}) }}">
        <button class="btn btn-primary">Clôturer le ticket</button>
    </form>
</div>
{% endif %}
{% endblock %}
