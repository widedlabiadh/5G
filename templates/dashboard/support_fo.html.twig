<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Dashboard Support FO — Orange Tunisie</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f5f5f5; }
        .sidebar {
            width: 250px; background: #1a1a2e; height: 100vh;
            position: fixed; left: 0; top: 0;
            display: flex; flex-direction: column; padding: 1.5rem;
        }
        .logo { display: flex; align-items: center; gap: 12px; margin-bottom: 2rem; }
        .logo-circle {
            width: 42px; height: 42px; background: #FF6600;
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; font-weight: 700; color: white; font-size: 18px;
        }
        .logo-text { color: white; font-size: 14px; font-weight: 500; }
        .logo-sub { color: #aaa; font-size: 11px; }
        .nav-section {
            font-size: 10px; color: #666;
            text-transform: uppercase; letter-spacing: 1px;
            margin: 1.5rem 0 0.5rem;
        }
        .nav-item {
            display: flex; align-items: center; gap: 10px;
            padding: 0.6rem 0.8rem; border-radius: 8px;
            color: #ccc; text-decoration: none; font-size: 13px;
            margin-bottom: 2px; transition: all 0.2s;
        }
        .nav-item:hover, .nav-item.active { background: #FF6600; color: white; }
        .main { margin-left: 250px; padding: 2rem; }
        .topbar {
            display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 2rem;
        }
        .topbar h1 { font-size: 20px; font-weight: 500; color: #333; }
        .user-badge {
            display: flex; align-items: center; gap: 10px;
            background: white; padding: 0.5rem 1rem;
            border-radius: 20px; border: 1px solid #eee;
            font-size: 13px; color: #555;
        }
        .avatar {
            width: 32px; height: 32px; background: #0066cc;
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; color: white; font-size: 13px; font-weight: 600;
        }
        .stats-grid {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 16px; margin-bottom: 2rem;
        }
        .stat-card {
            background: white; border-radius: 10px;
            padding: 1.2rem; border: 1px solid #eee;
        }
        .stat-label { font-size: 12px; color: #888; margin-bottom: 6px; }
        .stat-value { font-size: 26px; font-weight: 600; color: #333; }
        .stat-sub { font-size: 11px; color: #aaa; margin-top: 4px; }
        .section-title {
            font-size: 15px; font-weight: 500;
            color: #333; margin-bottom: 1rem;
        }
        .alerts-box {
            background: white; border-radius: 10px;
            border: 1px solid #eee; margin-bottom: 2rem;
            overflow: hidden;
        }
        .alerts-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #eee;
            display: flex; justify-content: space-between;
            align-items: center;
        }
        .alerts-header span { font-size: 14px; font-weight: 500; color: #333; }
        .badge-count {
            background: #cc0000; color: white;
            font-size: 11px; font-weight: 600;
            padding: 2px 8px; border-radius: 20px;
        }
        .alert-item {
            display: flex; align-items: center; gap: 12px;
            padding: 0.85rem 1.5rem;
            border-bottom: 1px solid #f5f5f5;
            font-size: 13px;
        }
        .alert-item:last-child { border-bottom: none; }
        .alert-dot {
            width: 10px; height: 10px;
            border-radius: 50%; flex-shrink: 0;
        }
        .dot-red { background: #cc0000; }
        .dot-orange { background: #FF6600; }
        .dot-green { background: #00cc66; }
        .alert-site { font-weight: 500; color: #333; min-width: 150px; }
        .alert-msg { color: #666; flex: 1; }
        .alert-time { color: #aaa; font-size: 11px; }
        .two-cols {
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        .info-card {
            background: white; border-radius: 10px;
            border: 1px solid #eee; padding: 1.5rem;
            border-top: 4px solid #0066cc;
        }
        .info-card h3 { font-size: 14px; font-weight: 500; color: #333; margin-bottom: 1rem; }
        .info-row {
            display: flex; justify-content: space-between;
            padding: 0.5rem 0; border-bottom: 1px solid #f5f5f5;
            font-size: 13px;
        }
        .info-row:last-child { border-bottom: none; }
        .info-label { color: #888; }
        .info-value { font-weight: 500; color: #333; }
        .logout-btn {
            margin-top: auto; display: flex; align-items: center; gap: 10px;
            padding: 0.6rem 0.8rem; border-radius: 8px;
            color: #ccc; text-decoration: none; font-size: 13px; transition: all 0.2s;
        }
        .logout-btn:hover { background: #cc0000; color: white; }
    </style>
</head>
<body>

<div class="sidebar">
    <div class="logo">
        <div class="logo-circle">O</div>
        <div>
            <div class="logo-text">Orange Tunisie</div>
            <div class="logo-sub">Transmission Monitor</div>
        </div>
    </div>

    <span class="nav-section">Support FO</span>
    <a href="#" class="nav-item active">🏠 Dashboard</a>
    <a href="#" class="nav-item">🔔 Alarmes</a>
    <a href="#" class="nav-item">📊 État du réseau</a>

    <span class="nav-section">Fibre Optique</span>
    <a href="#" class="nav-item">📡 Sites FO</a>
    <a href="#" class="nav-item">📈 Trafic</a>
    <a href="#" class="nav-item">⚠️ Congestions</a>

    <span class="nav-section">Rapports</span>
    <a href="#" class="nav-item">📅 Journalier</a>
    <a href="#" class="nav-item">📅 Hebdomadaire</a>
    <a href="#" class="nav-item">📅 Mensuel</a>
    <a href="#" class="nav-item">🕐 Historique</a>

    <a href="{{ path('app_logout') }}" class="logout-btn">🚪 Déconnexion</a>
</div>

<div class="main">
    <div class="topbar">
        <h1>Dashboard Support Fibre Optique</h1>
        <div class="user-badge">
            <div class="avatar">FO</div>
            {{ user.fullName ?? user.email }} 
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Sites FO actifs</div>
            <div class="stat-value">—</div>
            <div class="stat-sub">Total surveillés</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Congestions</div>
            <div class="stat-value" style="color:#cc0000">0</div>
            <div class="stat-sub">Aujourd'hui</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Alarmes actives</div>
            <div class="stat-value" style="color:#FF6600">0</div>
            <div class="stat-sub">Non résolues</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">QoS globale</div>
            <div class="stat-value" style="color:#00cc66">—</div>
            <div class="stat-sub">Fibre Optique</div>
        </div>
    </div>

    <div class="section-title">Alarmes récentes — Fibre Optique</div>
    <div class="alerts-box">
        <div class="alerts-header">
            <span>Alarmes du jour</span>
            <span class="badge-count">0</span>
        </div>
        <div class="alert-item">
            <div class="alert-dot dot-green"></div>
            <span class="alert-site">—</span>
            <span class="alert-msg">Aucune alarme active pour le moment</span>
            <span class="alert-time">—</span>
        </div>
    </div>

    <div class="two-cols">
        <div class="info-card">
            <h3>📡 État Fibre Optique</h3>
            <div class="info-row">
                <span class="info-label">Sites CoTrans</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Sites No-CoTrans</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Trafic max détecté</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Seuil critique (90%)</span>
                <span class="info-value">—</span>
            </div>
        </div>
        <div class="info-card">
            <h3>📈 Trafic Long Haul</h3>
            <div class="info-row">
                <span class="info-label">Trafic actuel</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Pic journalier</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Prévision J+1</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Tendance</span>
                <span class="info-value">—</span>
            </div>
        </div>
    </div>
</div>

</body>
</html>