{# templates/dashboard/index.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>NetWON - {{ roleLabel }}</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f0f2f5; }
        
        /* Sidebar - Navigation unifiée */
        .sidebar {
            width: 260px; background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
            height: 100vh; position: fixed; left: 0; top: 0;
            display: flex; flex-direction: column; padding: 1.5rem;
            z-index: 100; box-shadow: 2px 0 10px rgba(0,0,0,0.1);
        }
        .logo { display: flex; align-items: center; gap: 12px; margin-bottom: 2rem; }
        .logo-circle {
            width: 45px; height: 45px; background: linear-gradient(135deg, #f97316, #ea580c);
            border-radius: 12px; display: flex; align-items: center;
            justify-content: center; font-weight: 700; color: white; font-size: 20px;
        }
        .logo-text { color: white; font-size: 18px; font-weight: bold; }
        .logo-sub { color: #f97316; font-size: 10px; font-style: italic; }
        .nav-section {
            font-size: 11px; color: #64748b;
            text-transform: uppercase; letter-spacing: 1px;
            margin: 1.5rem 0 0.8rem;
        }
        .nav-item {
            display: flex; align-items: center; gap: 12px;
            padding: 0.7rem 1rem; border-radius: 10px;
            color: #cbd5e1; text-decoration: none; font-size: 13px;
            margin-bottom: 4px;
        }
        .nav-item:hover, .nav-item.active { background: rgba(249,115,22,0.2); color: #f97316; }
        .logout-btn {
            margin-top: auto; display: flex; align-items: center; gap: 12px;
            padding: 0.7rem 1rem; border-radius: 10px;
            color: #cbd5e1; text-decoration: none;
        }
        .logout-btn:hover { background: rgba(220,38,38,0.2); color: #ef4444; }
        
        .main { margin-left: 260px; padding: 1.5rem; }
        .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 15px; }
        .topbar h1 { font-size: 22px; font-weight: 600; color: #1e293b; }
        .role-badge {
            background: #f97316; color: white; padding: 5px 15px;
            border-radius: 20px; font-size: 12px; font-weight: 500;
        }
        
        .stats-grid {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 20px; margin-bottom: 25px;
        }
        .stat-card {
            background: white; border-radius: 16px; padding: 1.2rem;
            border: 1px solid #e2e8f0;
        }
        .stat-value { font-size: 28px; font-weight: 700; }
        .stat-label { font-size: 12px; color: #64748b; }
        
        .network-card {
            background: white; border-radius: 16px; padding: 1.2rem;
            border: 1px solid #e2e8f0;
            margin-bottom: 20px;
        }
        .network-item {
            display: flex; justify-content: space-between;
            padding: 8px 0; border-bottom: 1px solid #f1f5f9;
        }
        .badge-critical { background: #fee2e2; color: #dc2626; padding: 2px 10px; border-radius: 20px; font-size: 11px; }
        .badge {
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            display: inline-block;
        }
        .badge-pending { background: #fef3c7; color: #d97706; }
        .badge-progress { background: #dbeafe; color: #3b82f6; }
        .badge-done { background: #d1fae5; color: #10b981; }
        
        .user-badge {
            display: flex; align-items: center; gap: 12px;
            background: white; padding: 0.5rem 1rem;
            border-radius: 40px;
        }
        
        /* Table utilisateurs pour admin */
        .users-table {
            background: white; border-radius: 16px;
            border: 1px solid #e2e8f0; overflow: hidden;
        }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 12px 16px; background: #f8fafc; font-size: 12px; color: #64748b; }
        td { padding: 12px 16px; border-bottom: 1px solid #e2e8f0; font-size: 13px; }
        .btn-edit { background: #f97316; color: white; padding: 4px 12px; border-radius: 6px; text-decoration: none; font-size: 12px; }
        .btn-sm { padding: 4px 10px; font-size: 11px; }
        
        .btn-group { display: flex; gap: 12px; }
        .btn-import {
            background: linear-gradient(135deg, #f97316, #ea580c);
            color: white; border: none; padding: 10px 20px;
            border-radius: 40px; font-size: 13px; cursor: pointer;
            text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
        }
        
        .dashboard-row {
            display: grid; grid-template-columns: 1fr 320px;
            gap: 20px; margin-bottom: 25px;
        }
        #map { height: 450px; width: 100%; border-radius: 16px; }
        .filter-btn {
            padding: 5px 12px; border-radius: 20px; border: 1px solid #e2e8f0;
            background: white; font-size: 11px; cursor: pointer;
        }
        
        .muted { font-size: 11px; color: #64748b; }
        .mt-2 { margin-top: 8px; }
    </style>
</head>
<body>

<div class="sidebar">
    <div class="logo">
        <div class="logo-circle">N</div>
        <div><div class="logo-text">NetWON</div><div class="logo-sub">Monitor & Optimize</div></div>
    </div>
    
    <span class="nav-section">Navigation</span>
    <a href="{{ path('app_dashboard') }}" class="nav-item active">🏠 Dashboard</a>
    
    {# Menu spécifique selon le rôle #}
    {% if role == 'admin' %}
        <a href="{{ path('admin_users') }}" class="nav-item">👥 Gestion Users</a>
        <a href="{{ path('admin_settings') }}" class="nav-item">⚙️ Paramètres</a>
    {% elseif role == 'superuser' %}
        <a href="{{ path('import_excel') }}" class="nav-item">📂 Import Excel</a>
        <a href="{{ path('workflow_index') }}" class="nav-item">🎫 Workflows</a>
        <a href="#" class="nav-item">📊 Rapports</a>
        <span class="nav-section">Réseau</span>
        <a href="{{ path('superuser_fo') }}" class="nav-item">📡 Fibre Optique</a>
        <a href="{{ path('superuser_fh') }}" class="nav-item">🔗 Faisceaux Hertziens</a>
        <a href="{{ path('superuser_backbone') }}" class="nav-item">🌐 Backbone</a>
    {% elseif role == 'controleur' %}
        <a href="{{ path('workflow_index') }}" class="nav-item">🎫 Tickets</a>
        <a href="#" class="nav-item">🔄 Workflows</a>
    {% elseif role starts with 'support' %}
        <a href="{{ path('workflow_my_tasks') }}" class="nav-item">🎫 Mes tâches</a>
        <a href="#" class="nav-item">🔍 Monitoring</a>
    {% elseif role starts with 'ingenierie' %}
        <a href="{{ path('workflow_my_tasks') }}" class="nav-item">🎫 Mes tâches</a>
        <a href="#" class="nav-item">📡 Sites</a>
        <a href="#" class="nav-item">🔔 Alertes</a>
    {% elseif role == 'deploiement' %}
        <a href="#" class="nav-item">🗺️ Sites 5G</a>
        <a href="#" class="nav-item">📋 Planning</a>
    {% endif %}
    
    <a href="{{ path('app_logout') }}" class="logout-btn">🚪 Déconnexion</a>
</div>

<div class="main">
    <div class="topbar">
        <h1>Dashboard {{ roleLabel }}</h1>
        <div class="user-badge">
            <span>👤 {{ user.fullName ?? user.email }}</span>
            <span class="role-badge">{{ roleLabel }}</span>
        </div>
    </div>

    {# ========== PARTIE ADMIN ========== #}
    {% if role == 'admin' %}
        <div class="stats-grid">
            <div class="stat-card"><div class="stat-label">Total Utilisateurs</div><div class="stat-value">{{ totalUsers }}</div></div>
            <div class="stat-card"><div class="stat-label">Actifs</div><div class="stat-value" style="color:#10b981">{{ activeUsers }}</div></div>
            <div class="stat-card"><div class="stat-label">Inactifs</div><div class="stat-value" style="color:#ef4444">{{ inactiveUsers }}</div></div>
            <div class="stat-card"><div class="stat-label">Rôles</div><div class="stat-value">{{ roleCount }}</div></div>
        </div>
        
        <div class="users-table">
            <div style="padding: 1rem; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between;">
                <strong>📋 Liste des utilisateurs</strong>
                <a href="{{ path('admin_user_new') }}" class="btn-import" style="padding: 5px 15px;">+ Ajouter</a>
            </div>
            <tr>
                <thead><tr><th>Nom</th><th>Email</th><th>Rôle</th><th>Statut</th><th>Actions</th></tr></thead>
                <tbody>
                {% for u in users %}
                    <tr>
                        <td>{{ u.fullName ?? '—' }}</td>
                        <td>{{ u.email }}</td>
                        <td>{{ u.roleLabel }}</td>
                        <td>{% if u.isActive %}🟢 Actif{% else %}🔴 Inactif{% endif %}</td>
                        <td><a href="{{ path('admin_user_edit', {id: u.id}) }}" class="btn-edit">Modifier</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {# ========== PARTIE SUPERUSER (carte GPS + stats complètes) ========== #}
    {% if role == 'superuser' %}
        <div class="stats-grid">
            <div class="stat-card"><div class="stat-label">Sites Totaux</div><div class="stat-value">{{ stats.total_sites|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Congestions</div><div class="stat-value" style="color:#ef4444">{{ stats.total_occurrences|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Sites Critiques</div><div class="stat-value" style="color:#f97316">{{ sites_critiques|length|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Sans type</div><div class="stat-value">{{ stats.sans_type|default(0) }}</div></div>
        </div>

        <div class="dashboard-row">
            <div id="map"></div>
            <div class="network-card">
                <h3>📊 Répartition</h3>
                <canvas id="congestionChart" style="height: 200px;"></canvas>
                <div style="margin-top: 15px;">
                    <div class="network-item"><span>📡 FO</span><span>{{ stats.fo|default(0) }} sites</span></div>
                    <div class="network-item"><span>🔗 FH</span><span>{{ stats.fh|default(0) }} sites</span></div>
                    <div class="network-item"><span>🌐 Backbone</span><span>{{ stats.backbone|default(0) }} sites</span></div>
                </div>
            </div>
        </div>
        
        <div class="network-card">
            <h3>⚠️ Sites critiques</h3>
            {% for site in sites_critiques|slice(0, 10) %}
            <div class="network-item">
                <span><strong>{{ site.site }}</strong> ({{ site.typeTrans ?? 'NON_DEFINI' }})</span>
                <span class="badge-critical">{{ site.nombreOccurrences }} congestions</span>
            </div>
            {% endfor %}
        </div>
    {% endif %}

    {# ========== PARTIE CONTRÔLEUR ========== #}
    {% if role == 'controleur' %}
        <div class="stats-grid">
            <div class="stat-card"><div class="stat-label">Sites Totaux</div><div class="stat-value">{{ stats.total_sites|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Congestions</div><div class="stat-value" style="color:#ef4444">{{ stats.total_occurrences|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Tickets actifs</div><div class="stat-value" style="color:#f97316">{{ ticketsActifs|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">En retard</div><div class="stat-value" style="color:#ef4444">{{ ticketsOverdue|default(0) }}</div></div>
        </div>
        
        <div class="network-card">
            <h3>🎫 Tickets en cours</h3>
            {% if tickets is defined and tickets|length > 0 %}
                {% for ticket in tickets|slice(0, 10) %}
                <div class="network-item">
                    <div>
                        <strong>#{{ ticket.id }}</strong> - {{ ticket.title }}
                        <div class="muted">
                            <i class="fas fa-calendar"></i> {{ ticket.createdAt|date('d/m/Y') }}
                            {% if ticket.deadlineAt %}
                                | <i class="fas fa-hourglass-half"></i> {{ ticket.deadlineAt|date('d/m/Y') }}
                            {% endif %}
                        </div>
                    </div>
                    <div>
                        {% if ticket.status == 'open' %}
                            <span class="badge badge-pending">📋 Ouvert</span>
                        {% elseif ticket.status == 'in_progress' %}
                            <span class="badge badge-progress">⚙️ En cours</span>
                        {% elseif ticket.status == 'closed' %}
                            <span class="badge badge-done">✔️ Clôturé</span>
                        {% endif %}
                        <div class="muted mt-2">Progression: {{ ticket.progress }}%</div>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="network-item">Aucun ticket actif</div>
            {% endif %}
        </div>
        
        <div class="network-card">
            <h3>⚠️ Sites critiques à traiter</h3>
            {% for site in sites_critiques|slice(0, 10) %}
            <div class="network-item">
                <span><strong>{{ site.site }}</strong></span>
                <span class="badge-critical">{{ site.nombreOccurrences }} congestions</span>
            </div>
            {% endfor %}
        </div>
    {% endif %}

    {# ========== PARTIE SUPPORT FO / FH / INGÉNIERIE (MES TÂCHES) ========== #}
    {% if role == 'support_fo' or role == 'support_fh' or role == 'ingenierie_fh' or role == 'ingenierie_ip' %}
        <div class="stats-grid">
            <div class="stat-card"><div class="stat-label">Mes tâches</div><div class="stat-value">{{ myPendingTasks|length }}</div></div>
            <div class="stat-card"><div class="stat-label">En cours</div><div class="stat-value" style="color:#3b82f6">{{ myInProgressTasks|length }}</div></div>
            <div class="stat-card"><div class="stat-label">Terminées</div><div class="stat-value" style="color:#10b981">{{ myCompletedTasks|length }}</div></div>
            <div class="stat-card"><div class="stat-label">En retard</div><div class="stat-value" style="color:#ef4444">{{ myOverdueTasks|length }}</div></div>
        </div>

        <!-- Tâches en attente -->
        {% if myPendingTasks is defined and myPendingTasks|length > 0 %}
        <div class="network-card">
            <h3>⏳ Tâches en attente</h3>
            {% for task in myPendingTasks %}
            <div class="network-item">
                <div>
                    <strong>#{{ task.ticket.id }}</strong> - {{ task.title }}
                    <div class="muted">{{ task.ticket.title }}</div>
                </div>
                <div>
                    <span class="badge badge-pending">⏳ En attente</span>
                    <div class="muted mt-2">
                        <a href="{{ path('workflow_task_start', {id: task.id}) }}" class="btn-import btn-sm" style="padding: 4px 12px; font-size: 11px;" 
                           onclick="return confirm('Démarrer cette tâche ?')">
                            <i class="fas fa-play"></i> Démarrer
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Tâches en cours -->
        {% if myInProgressTasks is defined and myInProgressTasks|length > 0 %}
        <div class="network-card">
            <h3>⚙️ Tâches en cours</h3>
            {% for task in myInProgressTasks %}
            <div class="network-item">
                <div>
                    <strong>#{{ task.ticket.id }}</strong> - {{ task.title }}
                    <div class="muted">{{ task.ticket.title }}</div>
                    {% if task.ticket.deadlineAt %}
                    <div class="muted">Échéance: {{ task.ticket.deadlineAt|date('d/m/Y') }}</div>
                    {% endif %}
                </div>
                <div>
                    <span class="badge badge-progress">⚙️ En cours</span>
                    <div class="muted mt-2">
                        <a href="{{ path('workflow_task_complete', {id: task.id}) }}" class="btn-import btn-sm" style="padding: 4px 12px; font-size: 11px; background: #22c55e;">
                            <i class="fas fa-check"></i> Terminer
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Tâches terminées récentes -->
        {% if myCompletedTasks is defined and myCompletedTasks|length > 0 %}
        <div class="network-card">
            <h3>✅ Tâches terminées</h3>
            {% for task in myCompletedTasks|slice(0, 5) %}
            <div class="network-item">
                <div>
                    <strong>#{{ task.ticket.id }}</strong> - {{ task.title }}
                    <div class="muted">Terminée le {{ task.completedAt ? task.completedAt|date('d/m/Y') : '-' }}</div>
                </div>
                <div>
                    <span class="badge badge-done">✅ Terminée</span>
                    <div class="muted mt-2">
                        <a href="{{ path('workflow_show', {id: task.ticket.id}) }}" class="btn-import btn-sm" style="padding: 4px 12px; font-size: 11px; background: #64748b;">
                            <i class="fas fa-eye"></i> Voir
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Aucune tâche -->
        {% if myPendingTasks is empty and myInProgressTasks is empty %}
        <div class="network-card">
            <div class="network-item" style="justify-content: center; color: #64748b;">
                <i class="fas fa-check-circle" style="color: #10b981;"></i> Aucune tâche assignée pour le moment
            </div>
        </div>
        {% endif %}

        <!-- Sites critiques -->
        <div class="network-card">
            <h3>⚠️ Sites critiques</h3>
            {% for site in sites_critiques|slice(0, 10) %}
            <div class="network-item">
                <span><strong>{{ site.site }}</strong> ({{ site.typeTrans ?? 'NON_DEFINI' }})</span>
                <span class="badge-critical">{{ site.nombreOccurrences }} congestions</span>
            </div>
            {% endfor %}
        </div>
    {% endif %}

    {# ========== PARTIE GC / DÉPLOIEMENT ========== #}
    {% if role == 'gc' %}
        <div class="network-card">
            <h3>🏗️ Projets GC en cours</h3>
            <div class="network-item">Aucun projet pour le moment</div>
        </div>
    {% endif %}

    {% if role == 'deploiement' %}
        <div class="network-card">
            <h3>🚀 Sites 5G en déploiement</h3>
            <div class="network-item">Aucun site en déploiement</div>
        </div>
    {% endif %}
</div>

{# JavaScript pour la carte et graphiques #}
<script>
    {% if role == 'superuser' %}
    const sitesData = {{ sites_gps|json_encode|raw }};
    const map = L.map('map').setView([34.5, 9.5], 7);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png').addTo(map);
    
    // Restreindre les limites de la carte à la Tunisie
    const southWest = L.latLng(30.0, 7.0);
    const northEast = L.latLng(37.5, 12.0);
    const bounds = L.latLngBounds(southWest, northEast);
    map.setMaxBounds(bounds);
    
    sitesData.forEach(site => {
        if (site.latitude && site.longitude) {
            let color = '#94a3b8';
            if (site.statut === 'critique') color = '#ef4444';
            else if (site.statut === 'sous_observation') color = '#f59e0b';
            else if (site.statut === 'securise') color = '#10b981';
            
            const marker = L.marker([site.latitude, site.longitude], {
                icon: L.divIcon({ 
                    html: `<div style="background:${color}; width:14px; height:14px; border-radius:50%; border:2px solid white; box-shadow:0 0 4px rgba(0,0,0,0.3);"></div>`,
                    iconSize: [14, 14],
                    popupAnchor: [0, -7]
                })
            }).addTo(map);
            
            marker.bindPopup(`
                <b>${site.nom}</b><br>
                <span style="color:${color}">${site.statut === 'critique' ? '🔴 Critique' : (site.statut === 'sous_observation' ? '🟠 Sous observation' : (site.statut === 'securise' ? '🟢 Sécurisé' : '⚪ Non défini'))}</span><br>
                📡 Type: ${site.typeTrans}<br>
                📊 Congestions: ${site.nbOccurrences}<br>
                📈 Trafic: ${site.maxTrafic.toFixed(2)} Mbps
            `);
        }
    });
    
    new Chart(document.getElementById('congestionChart'), {
        type: 'doughnut',
        data: { labels: ['FO', 'FH', 'Backbone'], datasets: [{ data: [{{ stats.fo|default(0) }}, {{ stats.fh|default(0) }}, {{ stats.backbone|default(0) }}], backgroundColor: ['#f97316', '#38bdf8', '#94a3b8'] }] }
    });
    {% endif %}
</script>
</body>
</html>