{% extends 'base.html.twig' %}

{% block title %}Dashboard {{ roleLabel }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
{% endblock %}

{% block body %}
    {# *********************************************************** #}
    {# Tout le contenu HTML à l’intérieur de <div class="main">    #}
    {# (statistiques, carte, graphique, listes)                    #}
    {# *********************************************************** #}

    {# === ADMIN === #}
    {% if role == 'admin' %}
        <div class="stats-grid"> ... </div>
        <div class="users-table"> ... </div>
    {% endif %}

    {# === SUPERUSER === #}
    {% if role == 'superuser' %}
    {% include 'components/_navbar.html.twig' %}
        <div class="stats-grid">

            <div class="stat-card"><div class="stat-label">Sites Totaux</div><div class="stat-value">{{ stats.total_sites|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Congestions</div><div class="stat-value" style="color:#ef4444">{{ stats.total_occurrences|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Sites Critiques</div><div class="stat-value" style="color:#f97316">{{ total_sites_critiques|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Sans type</div><div class="stat-value">{{ stats.sans_type|default(0) }}</div></div>
        </div>

        <div class="dashboard-row">
            <div class="map-wrapper">
                <div class="map-header">
                    <h3>🗺️ Carte des sites réseau — Tunisie</h3>
                    <div class="filter-buttons">
                        <button class="filter-btn active" data-filter="all">Tous</button>
                        <button class="filter-btn" data-filter="critique">🔴 Critique</button>
                        <button class="filter-btn" data-filter="sous_observation">🟠 Sous observation</button>
                        <button class="filter-btn" data-filter="securise">🟢 Sécurisé</button>
                    </div>
                </div>
                <div id="map"></div>
            </div>
            <div class="network-card">
                <h3>📊 Répartition</h3>
                <canvas id="congestionChart" style="height: 200px;"></canvas>
                <div style="margin-top: 15px;">
                    <div class="network-item"><span>📡 FO</span><span>{{ stats.fo|default(0) }} sites</span></div>
                    <div class="network-item"><span>🔗 FH</span><span>{{ stats.fh|default(0) }} sites</span></div>
                    <div class="network-item"><span>🌐 Backbone</span><span>{{ stats.backbone|default(0) }} sites</span></div>
                </div>
            </div>
        </div>

        <div class="network-card">
            <h3>⚠️ Sites critiques</h3>
            {% for site in sites_critiques|slice(0, 10) %}
            <div class="network-item">
                <span><strong>{{ site.site }}</strong> ({{ site.typeTrans ?? 'NON_DEFINI' }})</span>
                <span class="badge-critical">{{ site.nombreOccurrences }} congestions</span>
            </div>
            {% endfor %}
        </div>
    {% endif %}

    {# === CONTRÔLEUR === #}
    {% if role == 'controleur' %}
        {# ... ton code pour contrôleur ... #}
    {% endif %}

    {# === SUPPORT / INGÉNIERIE === #}
    {% if role == 'support_fo' or role == 'support_fh' or role == 'ingenierie_fh' or role == 'ingenierie_ip' %}
        {# ... ton code pour support/ingenierie ... #}
    {% endif %}

    {# === GC / DÉPLOIEMENT === #}
    {% if role == 'gc' %} ... {% endif %}
    {% if role == 'deploiement' %} ... {% endif %}

{% endblock %}

{% block javascripts %}
    {# 1. Librairies externes #}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    {# 2. Données PHP → JS #}
    <script>
        window.sitesData = {{ sites_gps|json_encode|raw }};
        window.statsFO   = {{ stats.fo|default(0) }};
        window.statsFH   = {{ stats.fh|default(0) }};
        window.statsBackbone = {{ stats.backbone|default(0) }};
    </script>

    {# 3. Ton script personnalisé pour la carte et le graphique #}
    <script src="{{ asset('js/dashboard/map.js') }}"></script>
{% endblock %}