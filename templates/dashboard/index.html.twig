{% extends 'base.html.twig' %}

{% block title %}Dashboard {{ roleLabel }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    
    {# Styles pour Contrôleur (moderne) #}
    {% if role == 'controleur' %}
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      :root {
        --primary: #f97316;
        --primary-dark: #ea580c;
        --primary-light: #fff7ed;
        --blue: #3b82f6;
        --blue-light: #eff6ff;
        --red: #ef4444;
        --red-light: #fef2f2;
        --orange: #f59e0b;
        --orange-light: #fffbeb;
        --green: #10b981;
        --green-light: #ecfdf5;
        --purple: #8b5cf6;
        --purple-light: #f5f3ff;
        --slate: #475569;
        --slate-light: #f8fafc;
        --gray: #64748b;
        --gray-light: #f1f5f9;
        --border: #e2e8f0;
        --border-light: #f1f5f9;
        --card-radius: 24px;
        --shadow: 0 4px 20px rgba(0,0,0,0.05);
        --shadow-hover: 0 12px 30px rgba(0,0,0,0.1);
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: #f0f4f8;
        color: var(--slate);
      }

      .dashboard-container {
        padding: 28px 32px;
        max-width: 1600px;
        margin: 0 auto;
      }

      .hero-section {
        background: linear-gradient(135deg, #ffffff 0%, #fef9f1 100%);
        border-radius: var(--card-radius);
        padding: 32px 40px;
        margin-bottom: 32px;
        position: relative;
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
      }

      .hero-section::before {
        content: '';
        position: absolute;
        top: -30%;
        right: -10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(249,115,22,0.08) 0%, transparent 70%);
        border-radius: 50%;
      }

      .hero-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 24px;
        position: relative;
        z-index: 1;
      }

      .hero-title h1 {
        font-size: 28px;
        font-weight: 800;
        color: var(--slate);
        letter-spacing: -0.5px;
        margin-bottom: 8px;
      }

      .hero-title h1 span {
        background: linear-gradient(135deg, var(--primary), var(--orange));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .hero-title p {
        color: var(--gray);
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      .live-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--green-light);
        color: var(--green);
        padding: 4px 12px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 600;
      }

      .live-dot {
        width: 7px;
        height: 7px;
        background: var(--green);
        border-radius: 50%;
        animation: pulse 1.5s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }

      .hero-stats {
        display: flex;
        gap: 40px;
      }

      .hero-stat {
        text-align: center;
      }

      .hero-stat .value {
        font-size: 32px;
        font-weight: 800;
        color: var(--slate);
      }

      .hero-stat .label {
        font-size: 11px;
        color: var(--gray);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 32px;
      }

      .kpi-card {
        background: white;
        border-radius: var(--card-radius);
        padding: 20px;
        border: 1px solid var(--border);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }

      .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
        border-color: var(--primary);
      }

      .kpi-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--kpi-color, var(--primary));
      }

      .kpi-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
      }

      .kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        background: var(--icon-bg);
        color: var(--kpi-color);
      }

      .kpi-tag {
        font-size: 10px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 30px;
      }

      .tag-up { background: var(--green-light); color: var(--green); }
      .tag-down { background: var(--red-light); color: var(--red); }
      .tag-neutral { background: var(--gray-light); color: var(--gray); }

      .kpi-value {
        font-size: 34px;
        font-weight: 800;
        color: var(--slate);
        line-height: 1;
        margin-bottom: 8px;
      }

      .kpi-label {
        font-size: 13px;
        color: var(--gray);
        font-weight: 500;
      }

      .kpi-sub {
        font-size: 11px;
        color: #94a3b8;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid var(--border-light);
      }

      .charts-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 32px;
      }

      .chart-card {
        background: white;
        border-radius: var(--card-radius);
        padding: 24px;
        border: 1px solid var(--border);
        transition: box-shadow 0.3s ease;
      }

      .chart-card:hover {
        box-shadow: var(--shadow);
      }

      .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
      }

      .card-header h3 {
        font-size: 16px;
        font-weight: 700;
        color: var(--slate);
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .card-badge {
        font-size: 11px;
        font-weight: 600;
        background: var(--gray-light);
        color: var(--gray);
        padding: 4px 12px;
        border-radius: 30px;
      }

      .chart-container {
        height: 260px;
        position: relative;
      }

      .legend {
        display: flex;
        gap: 20px;
        margin-top: 16px;
        justify-content: center;
      }

      .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: var(--gray);
      }

      .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 2px;
      }

      .traffic-card {
        background: white;
        border-radius: var(--card-radius);
        padding: 24px;
        border: 1px solid var(--border);
        margin-bottom: 32px;
      }

      .bottom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 24px;
        margin-bottom: 32px;
      }

      .info-card {
        background: white;
        border-radius: var(--card-radius);
        padding: 20px;
        border: 1px solid var(--border);
      }

      .info-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
      }

      .info-card-header h3 {
        font-size: 14px;
        font-weight: 700;
        color: var(--slate);
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .ticket-list, .gov-list, .risk-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .ticket-item, .gov-item, .risk-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        background: var(--gray-light);
        border-radius: 16px;
        transition: all 0.2s ease;
      }

      .ticket-item:hover, .gov-item:hover, .risk-item:hover {
        background: white;
        box-shadow: var(--shadow);
      }

      .ticket-info .ticket-id {
        font-size: 12px;
        font-weight: 700;
        color: var(--slate);
      }

      .ticket-info .ticket-meta {
        font-size: 10px;
        color: var(--gray);
        margin-top: 2px;
      }

      .ticket-status {
        font-size: 10px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 30px;
      }

      .status-open { background: var(--blue-light); color: var(--blue); }
      .status-progress { background: var(--orange-light); color: var(--orange); }
      .status-pending { background: var(--purple-light); color: var(--purple); }
      .status-closed { background: var(--green-light); color: var(--green); }
      .status-overdue { background: var(--red-light); color: var(--red); }

      .gov-bar {
        flex: 1;
        height: 6px;
        background: #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
        margin: 0 12px;
      }

      .gov-bar-fill {
        height: 100%;
        border-radius: 10px;
        transition: width 0.5s ease;
      }

      .risk-percent {
        font-size: 12px;
        font-weight: 700;
      }

      .critical-table-wrapper {
        background: white;
        border-radius: var(--card-radius);
        border: 1px solid var(--border);
        overflow: hidden;
        margin-bottom: 32px;
      }

      .table-header {
        padding: 18px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
      }

      .table-header h3 {
        font-size: 16px;
        font-weight: 700;
        color: var(--slate);
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .critical-badge {
        background: var(--red-light);
        color: var(--red);
        padding: 4px 14px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 600;
      }

      .critical-table {
        width: 100%;
        border-collapse: collapse;
      }

      .critical-table th {
        text-align: left;
        padding: 14px 20px;
        background: #fafcff;
        font-size: 11px;
        font-weight: 600;
        color: var(--gray);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid var(--border);
      }

      .critical-table td {
        padding: 14px 20px;
        font-size: 12px;
        color: var(--slate);
        border-bottom: 1px solid var(--border-light);
      }

      .critical-table tr:hover td {
        background: #fafcff;
      }

      .site-name {
        font-family: monospace;
        font-weight: 600;
        font-size: 12px;
      }

      .type-pill {
        background: var(--blue-light);
        color: var(--blue);
        padding: 3px 10px;
        border-radius: 30px;
        font-size: 10px;
        font-weight: 600;
        display: inline-block;
      }

      .util-bar {
        width: 80px;
        height: 5px;
        background: #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
        margin-right: 8px;
      }

      .util-bar-fill {
        height: 100%;
        border-radius: 10px;
      }

      .util-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .occ-badge {
        background: var(--red-light);
        color: var(--red);
        padding: 3px 10px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
        display: inline-block;
      }

      .status-critical {
        background: var(--red-light);
        color: var(--red);
        padding: 3px 10px;
        border-radius: 30px;
        font-size: 10px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }

      .empty-state {
        text-align: center;
        padding: 48px;
        color: var(--gray);
      }

      .empty-state i {
        font-size: 48px;
        margin-bottom: 16px;
        opacity: 0.4;
      }

      .synthesis-footer {
        background: linear-gradient(135deg, #ffffff 0%, #fef9f1 100%);
        border-radius: var(--card-radius);
        padding: 24px 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
      }

      .synthesis-footer h4 {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 4px;
        color: var(--slate);
      }

      .synthesis-footer p {
        font-size: 11px;
        color: var(--gray);
      }

      .synthesis-stats {
        display: flex;
        gap: 32px;
      }

      .synthesis-stat {
        text-align: center;
      }

      .synthesis-stat .value {
        font-size: 28px;
        font-weight: 800;
        color: var(--slate);
      }

      .synthesis-stat .label {
        font-size: 10px;
        color: var(--gray);
        text-transform: uppercase;
      }

      @media (max-width: 1200px) {
        .dashboard-container { padding: 20px; }
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .charts-row { grid-template-columns: 1fr; }
        .bottom-grid { grid-template-columns: 1fr; }
      }

      @media (max-width: 768px) {
        .kpi-grid { grid-template-columns: 1fr; }
        .hero-content { flex-direction: column; text-align: center; }
        .hero-stats { justify-content: center; }
        .synthesis-footer { flex-direction: column; text-align: center; }
        .synthesis-stats { justify-content: center; }
      }
    </style>
    {% endif %}

    {# Styles pour SUPERUSER #}
    {% if role == 'superuser' %}
    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }
        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 1.2rem;
            border: 1px solid #e2e8f0;
        }
        .stat-value {
            font-size: 28px;
            font-weight: 700;
        }
        .stat-label {
            font-size: 12px;
            color: #64748b;
        }
        .dashboard-row {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 20px;
            margin-bottom: 25px;
        }
        .map-wrapper {
            background: white;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            overflow: hidden;
        }
        .map-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            border-bottom: 1px solid #f1f5f9;
            flex-wrap: nowrap;
            gap: 10px;
        }
        .map-header h3 { font-size: 14px; font-weight: 600; color: #1e293b; margin: 0; }
        .filter-buttons { display: flex; gap: 8px; align-items: center; }
        .filter-btn {
            padding: 4px 12px;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            background: white;
            font-size: 11px;
            cursor: pointer;
        }
        .filter-btn.active { background: #f97316; color: white; border-color: #f97316; }
        .map-tool-btn {
            padding: 4px 12px;
            border-radius: 20px;
            border: 1px solid #fed7aa;
            background: #fff7ed;
            color: #c2410c;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
        }
        .map-tool-btn.active {
            background: #f97316;
            border-color: #f97316;
            color: #fff;
        }
        .map-tool-btn:disabled {
            cursor: not-allowed;
            opacity: 0.55;
        }
        #map { height: 420px; width: 100%; }
        .map-selection-panel {
            display: none;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 10px 16px;
            border-top: 1px solid #f1f5f9;
            background: #fff;
        }
        .map-selection-panel.open { display: flex; }
        .map-selection-summary {
            min-width: 0;
            font-size: 12px;
            color: #475569;
        }
        .map-selection-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 26px;
            height: 22px;
            margin-right: 8px;
            border-radius: 999px;
            background: #fff7ed;
            color: #ea580c;
            font-weight: 700;
        }
        .map-selection-list {
            display: block;
            margin-top: 3px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #64748b;
        }
        .map-selection-actions {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }
        .map-selection-export,
        .map-selection-clear {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            border: 1px solid #e2e8f0;
            padding: 7px 13px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .map-selection-export {
            background: #059669;
            border-color: #059669;
            color: #fff;
        }
        .map-selection-export:disabled {
            cursor: not-allowed;
            opacity: 0.55;
        }
        .map-selection-clear {
            background: #fff;
            color: #475569;
        }
        .leaflet-draw-toolbar a {
            border-radius: 8px !important;
        }
        .network-card {
            background: white;
            border-radius: 16px;
            padding: 1.2rem;
            border: 1px solid #e2e8f0;
            margin-bottom: 20px;
        }
        .network-item {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #f1f5f9;
        }
        .badge-critical { background: #fee2e2; color: #dc2626; padding: 2px 10px; border-radius: 20px; font-size: 11px; }
        .badge-util { background: #eff6ff; color: #2563eb; padding: 2px 10px; border-radius: 20px; font-size: 11px; margin-left: 6px; }
    </style>
    {% endif %}

    {# Styles pour ADMIN #}
    {% if role == 'admin' %}
    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }
        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 1.2rem;
            border: 1px solid #e2e8f0;
        }
        .stat-value { font-size: 28px; font-weight: 700; }
        .stat-label { font-size: 12px; color: #64748b; }
        .users-table {
            background: white;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            overflow: hidden;
            margin-top: 20px;
        }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 12px 16px; background: #f8fafc; font-size: 12px; color: #64748b; }
        td { padding: 12px 16px; border-bottom: 1px solid #e2e8f0; font-size: 13px; }
        .btn-edit { background: #f97316; color: white; padding: 4px 12px; border-radius: 6px; text-decoration: none; font-size: 12px; }
        .btn-import { background: linear-gradient(135deg, #f97316, #ea580c); color: white; border: none; padding: 10px 20px; border-radius: 40px; font-size: 13px; cursor: pointer; text-decoration: none; }
    </style>
    {% endif %}
{% endblock %}

{% block body %}
    {# ==================== ADMIN ==================== #}
    {% if role == 'admin' %}
        <div class="stats-grid">
            <div class="stat-card"><div class="stat-label">Total Utilisateurs</div><div class="stat-value">{{ totalUsers|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Actifs</div><div class="stat-value" style="color:#10b981">{{ activeUsers|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Inactifs</div><div class="stat-value" style="color:#ef4444">{{ inactiveUsers|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Rôles</div><div class="stat-value">{{ roleCount|default(0) }}</div></div>
        </div>
        
        <div class="users-table">
            <div style="padding: 1rem; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between;">
                <strong>📋 Liste des utilisateurs</strong>
                <a href="{{ path('admin_user_new') }}" class="btn-import" style="padding: 5px 15px;">+ Ajouter</a>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for u in users|default([]) %}
                    <tr>
                        <td>{{ u.fullName ?? '—' }}</td>
                        <td>{{ u.email }}</td>
                        <td>{{ u.roleLabel }}</td>
                        <td>{% if u.isActive %}🟢 Actif{% else %}🔴 Inactif{% endif %}</td>
                        <td><a href="{{ path('admin_user_edit', {id: u.id}) }}" class="btn-edit">Modifier</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {# ==================== SUPERUSER ==================== #}
    {% if role == 'superuser' %}
        <div class="stats-grid">
            <div class="stat-card"><div class="stat-label">Sites Totaux</div><div class="stat-value">{{ stats.total_sites|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Congestions</div><div class="stat-value" style="color:#ef4444">{{ stats.sites_congestionnes|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Sites Critiques</div><div class="stat-value" style="color:#f97316">{{ total_sites_critiques|default(0) }}</div></div>
            <div class="stat-card"><div class="stat-label">Sans type</div><div class="stat-value">{{ stats.sans_type|default(0) }}</div></div>
        </div>
        <div class="dashboard-row">
            <div class="map-wrapper">
                <div class="map-header">
                    <div class="filter-buttons">
                        <button class="filter-btn active" data-filter="all">Tous</button>
                        <button class="filter-btn" data-filter="critique">🔴 Critique</button>
                        <button class="filter-btn" data-filter="sous_observation">🟠 Sous observation</button>
                        <button class="filter-btn" data-filter="securise">🟢 Sécurisé</button>
                    </div>
                </div>
                <div id="map"></div>
                <div class="map-selection-panel" id="mapSelectionPanel">
                    <div class="map-selection-summary">
                        <span class="map-selection-count" id="mapSelectionCount">0</span>
                        site(s) selectionne(s)
                        <span class="map-selection-list" id="mapSelectionList"></span>
                    </div>
                    <div class="map-selection-actions">
                        <button type="button" class="map-selection-clear" id="mapSelectionClear">Effacer</button>
                        <button type="button" class="map-selection-export" id="mapSelectionExport" disabled>Exporter Excel</button>
                    </div>
                </div>
            </div>
            <div class="network-card">
                <h3>📊 Répartition</h3>
                <canvas id="congestionChart" style="height: 200px;"></canvas>
                <div style="margin-top: 15px;">
                    <div class="network-item"><span>📡 FO</span><span>{{ stats.fo|default(0) }} sites</span></div>
                    <div class="network-item"><span>🔗 FH</span><span>{{ stats.fh|default(0) }} sites</span></div>
                    <div class="network-item"><span>🌐 Backhaul Sharing</span><span>{{ stats.backbone|default(0) }} sites</span></div>
                </div>
            </div>
        </div>

        <div class="network-card">
            <h3>⚠️ Sites critiques</h3>
            {% for site in sites_critiques|slice(0, 10) %}
            {% set tauxUtil = site.tauxUtilisation is not null ? site.tauxUtilisation : null %}
            <div class="network-item">
                <span><strong>{{ site.site|clean_site }}</strong> ({{ site.typeTrans ?? 'NON_DEFINI' }})</span>
                <span>
                    <span class="badge-critical">{{ site.nombreOccurrences }} congestions</span>
                    <span class="badge-util">{{ tauxUtil is not null ? (tauxUtil + 0)|number_format(2, ',', ' ') ~ '% util.' : 'util. —' }}</span>
                </span>
            </div>
            {% endfor %}
        </div>

        {# IA - Détection d'anomalies - CORRIGÉ #}
        <div class="network-card" style="margin-top: 20px;">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <h3>
                    <i class="fas fa-robot" style="color: #ff6200;"></i>
                    🤖 IA - Détection d'anomalies
                    <span id="iaStatusBadge" class="badge bg-secondary ms-2" style="font-size: 10px;">Chargement...</span>
                </h3>
                <button id="refreshIaAnomalies" class="btn btn-sm btn-outline-warning" style="padding: 4px 12px; font-size: 11px;">
                    <i class="fas fa-sync-alt"></i> Actualiser
                </button>
            </div>
            <div id="iaAnomaliesList" class="p-3">
                <div class="text-center py-4">
                    <div class="spinner-border text-warning" role="status" style="width: 30px; height: 30px;"></div>
                    <p class="mt-2 text-muted small">Chargement des anomalies IA...</p>
                </div>
            </div>
        </div>

    {% endif %}

    {# ==================== CONTRÔLEUR ==================== #}
    {% if role == 'controleur' %}
        {% set stats = stats|default({'total_sites': 0, 'fo': 0, 'fh': 0, 'backbone': 0, 'max_trafic_fo': 0}) %}
        {% set siteHealthStats = siteHealthStats|default({'total': 0, 'congestionnes': 0, 'brides': 0, 'ok': 0, 'avg_taux': 0}) %}
        {% set ticketStats = ticketStats|default({'total': 0, 'open': 0, 'in_progress': 0, 'pending': 0, 'closed': 0, 'overdue': 0}) %}
        {% set sites_critiques = sites_critiques|default([]) %}
        {% set tickets = tickets|default([]) %}
        {% set topHealthRisks = topHealthRisks|default([]) %}
        {% set statsByGouvernorat = statsByGouvernorat|default([]) %}
        {% set trafficData = trafficData|default([]) %}

        {% set riskTotal = siteHealthStats.congestionnes + siteHealthStats.brides %}
        {% set riskRate = siteHealthStats.total > 0 ? ((riskTotal / siteHealthStats.total) * 100)|round(1) : 0 %}

        <div class="dashboard-container">
            <div class="hero-section">
                <div class="hero-content">
                    <div class="hero-title">
                        <h1>Network <span>Intelligence</span> Center</h1>
                        <p>
                            <span class="live-badge"><span class="live-dot"></span> LIVE · Supervision temps réel</span>
                            <span><i class="fas fa-chart-line"></i> {{ stats.total_sites }} sites surveillés</span>
                        </p>
                    </div>
                    <div class="hero-stats">
                        <div class="hero-stat">
                            <div class="value">{{ stats.total_sites }}</div>
                            <div class="label">Sites total</div>
                        </div>
                        <div class="hero-stat">
                            <div class="value">{{ stats.fo + stats.fh + stats.backbone }}</div>
                            <div class="label">Liens actifs</div>
                        </div>
                        <div class="hero-stat">
                            <div class="value">{{ (siteHealthStats.avg_taux + 0)|number_format(2, ',', ' ') }}%</div>
                            <div class="label">Utilisation moy.</div>
                        </div>
                        <div class="hero-stat">
                            <div class="value">{{ ticketStats.overdue }}</div>
                            <div class="label">Tickets en retard</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="kpi-grid">
                <div class="kpi-card" style="--kpi-color: var(--blue); --icon-bg: var(--blue-light);">
                    <div class="kpi-header">
                        <div class="kpi-icon"><i class="fas fa-tower-cell"></i></div>
                    </div>
                    <div class="kpi-value">{{ stats.total_sites }}</div>
                    <div class="kpi-label">Sites supervisés</div>
                    <div class="kpi-sub">FO: {{ stats.fo }} · FH: {{ stats.fh }} · Backhaul Sharing: {{ stats.backbone }}</div>
                </div>

                <div class="kpi-card" style="--kpi-color: var(--red); --icon-bg: var(--red-light);">
                    <div class="kpi-header">
                        <div class="kpi-icon"><i class="fas fa-circle-exclamation"></i></div>
                        <span class="kpi-tag tag-up">🔴 Critique</span>
                    </div>
                    <div class="kpi-value">{{ siteHealthStats.congestionnes }}</div>
                    <div class="kpi-label">Sites congestionnés</div>
                    <div class="kpi-sub">{{ siteHealthStats.brides }} bridés · Risque: {{ riskRate }}%</div>
                </div>

                <div class="kpi-card" style="--kpi-color: var(--orange); --icon-bg: var(--orange-light);">
                    <div class="kpi-header">
                        <div class="kpi-icon"><i class="fas fa-ticket-alt"></i></div>
                        <span class="kpi-tag {{ ticketStats.overdue > 0 ? 'tag-down' : 'tag-neutral' }}">
                            {{ ticketStats.overdue }} en retard
                        </span>
                    </div>
                    <div class="kpi-value">{{ ticketStats.total }}</div>
                    <div class="kpi-label">Tickets actifs</div>
                    <div class="kpi-sub">{{ ticketStats.in_progress }} en cours · {{ ticketStats.pending }} validation</div>
                </div>

                <div class="kpi-card" style="--kpi-color: var(--green); --icon-bg: var(--green-light);">
                    <div class="kpi-header">
                        <div class="kpi-icon"><i class="fas fa-chart-line"></i></div>
                        <span class="kpi-tag {{ siteHealthStats.avg_taux > 80 ? 'tag-down' : 'tag-up' }}">
                            {{ (siteHealthStats.avg_taux + 0)|number_format(2, ',', ' ') }}% moy.
                        </span>
                    </div>
                    <div class="kpi-value">{{ stats.max_trafic_fo|default(0)|number_format(0, ',', ' ') }} <span style="font-size: 14px;">Mbps</span></div>
                    <div class="kpi-label">Pic de trafic</div>
                    <div class="kpi-sub">{{ siteHealthStats.ok }} sites OK · {{ (siteHealthStats.avg_taux + 0)|number_format(2, ',', ' ') }}% utilisation</div>
                </div>
            </div>

            <div class="charts-row">
                <div class="chart-card">
                    <div class="card-header">
                        <h3><i class="fas fa-map-marked-alt" style="color: var(--primary);"></i> Congestion & Bridage par gouvernorat</h3>
                        <span class="card-badge">{{ statsByGouvernorat|length }} zones</span>
                    </div>
                    <div class="chart-container">
                        <canvas id="govChart"></canvas>
                    </div>
                    <div class="legend">
                        <div class="legend-item"><span class="legend-dot" style="background: var(--red);"></span> Congestionnés</div>
                        <div class="legend-item"><span class="legend-dot" style="background: var(--orange);"></span> Bridés</div>
                    </div>
                </div>

                <div class="chart-card">
                    <div class="card-header">
                        <h3><i class="fas fa-heartbeat" style="color: var(--green);"></i> État de santé réseau</h3>
                        <span class="card-badge">Temps réel</span>
                    </div>
                    <div class="chart-container">
                        <canvas id="healthChart"></canvas>
                    </div>
                    <div class="legend" style="justify-content: center; gap: 16px;">
                        <div class="legend-item"><span class="legend-dot" style="background: var(--green);"></span> OK ({{ siteHealthStats.ok }})</div>
                        <div class="legend-item"><span class="legend-dot" style="background: var(--red);"></span> Congestion ({{ siteHealthStats.congestionnes }})</div>
                        <div class="legend-item"><span class="legend-dot" style="background: var(--orange);"></span> Bridé ({{ siteHealthStats.brides }})</div>
                    </div>
                </div>
            </div>

            <div class="traffic-card">
                <div class="card-header">
                    <h3><i class="fas fa-waveform" style="color: var(--blue);"></i> Trafic réseau — 7 derniers jours</h3>
                    <span class="card-badge">Mbps</span>
                </div>
                <div class="chart-container" style="height: 220px;">
                    <canvas id="trafficChart"></canvas>
                </div>
                <div class="legend">
                    <div class="legend-item"><span class="legend-dot" style="background: var(--blue);"></span> Trafic entrant</div>
                    <div class="legend-item"><span class="legend-dot" style="background: var(--green); opacity: 0.5;"></span> Capacité</div>
                </div>
            </div>

            <div class="bottom-grid">
                <div class="info-card">
                    <div class="info-card-header">
                        <h3><i class="fas fa-ticket" style="color: var(--blue);"></i> Tickets récents</h3>
                        <span class="card-badge">{{ tickets|length }} actifs</span>
                    </div>
                    <div class="ticket-list">
                        {% if tickets|length > 0 %}
                            {% for ticket in tickets|slice(0, 6) %}
                            <div class="ticket-item">
                                <div class="ticket-info">
                                    <div class="ticket-id">#{{ ticket.id }} · {{ ticket.title|default('Sans titre')|slice(0, 35) }}{% if ticket.title|length > 35 %}...{% endif %}</div>
                                    <div class="ticket-meta"><i class="fas fa-user"></i> {{ ticket.created_by_name|default('—') }} · {{ ticket.created_at|date('d/m/Y') }}</div>
                                </div>
                                {% if ticket.status == 'open' %}
                                    <span class="ticket-status status-open">📌 Ouvert</span>
                                {% elseif ticket.status == 'in_progress' %}
                                    <span class="ticket-status status-progress">⚙️ En cours</span>
                                {% elseif ticket.status == 'pending_validation' %}
                                    <span class="ticket-status status-pending">📋 Validation</span>
                                {% elseif ticket.status == 'closed' %}
                                    <span class="ticket-status status-closed">✅ Clôturé</span>
                                {% else %}
                                    <span class="ticket-status status-overdue">⚠️ En retard</span>
                                {% endif %}
                            </div>
                            {% endfor %}
                        {% else %}
                            <div class="empty-state">
                                <i class="fas fa-inbox"></i>
                                <p>Aucun ticket récent</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-card-header">
                        <h3><i class="fas fa-triangle-exclamation" style="color: var(--orange);"></i> Gouvernorats à risque</h3>
                        <span class="card-badge">Top risque</span>
                    </div>
                    <div class="gov-list">
                        {% if statsByGouvernorat|length > 0 %}
                            {% set maxRisk = 0 %}
                            {% for g in statsByGouvernorat %}
                                {% set totalRisk = g.congestionnes|default(0) + g.brides|default(0) %}
                                {% if totalRisk > maxRisk %}{% set maxRisk = totalRisk %}{% endif %}
                            {% endfor %}
                            {% for g in statsByGouvernorat|slice(0, 7) %}
                                {% set totalRisk = g.congestionnes|default(0) + g.brides|default(0) %}
                                {% set riskPercent = maxRisk > 0 ? (totalRisk / maxRisk * 100)|round : 0 %}
                                {% if riskPercent > 70 %}{% set barColor = '#ef4444' %}
                                {% elseif riskPercent > 40 %}{% set barColor = '#f59e0b' %}
                                {% else %}{% set barColor = '#10b981' %}{% endif %}
                                <div class="gov-item">
                                    <span style="font-weight: 600; min-width: 80px;">{{ g.gouvernorat }}</span>
                                    <div class="gov-bar">
                                        <div class="gov-bar-fill" style="width: {{ riskPercent }}%; background: {{ barColor }};"></div>
                                    </div>
                                    <span style="font-size: 11px; font-weight: 600; min-width: 50px; text-align: right;">{{ totalRisk }} sites</span>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="empty-state">
                                <i class="fas fa-check-circle" style="color: var(--green);"></i>
                                <p>Aucune donnée par gouvernorat</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-card-header">
                        <h3><i class="fas fa-chart-line" style="color: var(--orange);"></i> Sites bridés</h3>
                        <span class="card-badge">{{ siteHealthStats.brides }} détectés</span>
                    </div>
                    <div class="risk-list">
                        {% set brides = topHealthRisks|filter(v => v.etat in ['BRIDE', 'BRIDAGE']) %}
                        {% if brides|length > 0 %}
                            {% for site in brides|slice(0, 6) %}
                            <div class="risk-item">
                                <div>
                                    <div style="font-weight: 600; font-family: monospace; font-size: 12px;">{{ site.site|clean_site }}</div>
                                    <div style="font-size: 10px; color: var(--gray);">{{ site.typeTrans|default('—') }} · {{ site.classification|default('—') }}</div>
                                </div>
                                <span class="risk-percent" style="color: var(--orange);">{{ (site.taux_utilisation|default(0))|number_format(2, ',', ' ') }}%</span>
                            </div>
                            {% endfor %}
                        {% else %}
                            <div class="empty-state">
                                <i class="fas fa-check-circle" style="color: var(--green);"></i>
                                <p>Aucun site bridé</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="critical-table-wrapper">
                <div class="table-header">
                    <h3><i class="fas fa-bell" style="color: var(--red);"></i> Sites critiques — Action immédiate requise</h3>
                    <span class="critical-badge">{{ sites_critiques|length }} alerte(s)</span>
                </div>
                {% if sites_critiques|length > 0 %}
                <div style="overflow-x: auto;">
                    <table class="critical-table">
                        <thead>
                            <tr>
                                <th>Site</th>
                                <th>Type</th>
                                <th>Classification</th>
                                <th>Trafic max</th>
                                <th>Capacité</th>
                                <th>Utilisation</th>
                                <th>Occurrences</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for site in sites_critiques|slice(0, 10) %}
                                {% set cap = site.capaciteMbps|default(0) %}
                                {% set util = site.tauxUtilisation is not null ? site.tauxUtilisation : (cap > 0 ? ((site.maxTrafic / cap) * 100) : null) %}
                                <tr>
                                    <td><span class="site-name">{{ site.site|clean_site }}</span></td>
                                    <td><span class="type-pill">{{ site.typeTrans|default('NON_DEFINI') }}</span></td>
                                    <td><span class="status-critical" style="background: var(--red-light);">{{ site.classification|default('-') }}</span></td>
                                    <td><strong>{{ site.maxTrafic|number_format(1, ',', ' ') }} <span style="font-size: 10px;">Mbps</span></strong></td>
                                    <td>{% if cap > 0 %}{{ cap|number_format(0, ',', ' ') }} Mbps{% else %}<span style="color: var(--gray);">—</span>{% endif %}</td>
                                    <td>
                                        {% if util is not null %}
                                        <div class="util-wrap">
                                            <div class="util-bar"><div class="util-bar-fill" style="width: {{ util > 100 ? 100 : util }}%; background: {{ util > 90 ? '#ef4444' : (util > 70 ? '#f59e0b' : '#10b981') }};"></div></div>
                                            <span style="font-size: 11px; font-weight: 600;">{{ (util + 0)|number_format(2, ',', ' ') }}%</span>
                                        </div>
                                        {% else %}
                                        <span style="color: var(--gray);">—</span>
                                        {% endif %}
                                    </td>
                                    <td><span class="occ-badge">{{ site.nombreOccurrences|default(0) }}</span></td>
                                    <td><span class="status-critical"><i class="fas fa-circle" style="font-size: 6px;"></i> CRITIQUE</span></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="empty-state">
                    <i class="fas fa-check-circle" style="color: var(--green);"></i>
                    <p>Aucun site critique — Réseau stable</p>
                </div>
                {% endif %}
            </div>

            <div class="synthesis-footer">
                <div>
                    <h4><i class="fas fa-chart-simple"></i> Synthèse opérationnelle</h4>
                    <p>État du réseau au {{ "now"|date("d/m/Y H:i") }}</p>
                </div>
                <div class="synthesis-stats">
                    <div class="synthesis-stat">
                        <div class="value">{{ stats.total_sites }}</div>
                        <div class="label">Sites total</div>
                    </div>
                    <div class="synthesis-stat">
                        <div class="value" style="color: var(--red);">{{ siteHealthStats.congestionnes }}</div>
                        <div class="label">Congestionnés</div>
                    </div>
                    <div class="synthesis-stat">
                        <div class="value" style="color: var(--orange);">{{ siteHealthStats.brides }}</div>
                        <div class="label">Bridés</div>
                    </div>
                    <div class="synthesis-stat">
                        <div class="value" style="color: var(--blue);">{{ ticketStats.total }}</div>
                        <div class="label">Tickets</div>
                    </div>
                    <div class="synthesis-stat">
                        <div class="value" style="color: var(--green);">{{ siteHealthStats.ok }}</div>
                        <div class="label">Sites OK</div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ==================== SUPPORT / INGÉNIERIE ==================== #}
    {% if role == 'support_fo' or role == 'support_fh' or role == 'support_radio' or role == 'ingenierie_fh' or role == 'ingenierie_ip' %}
        <div class="stats-grid">
            <div class="stat-card"><div class="stat-label">Mes tâches</div><div class="stat-value">{{ myPendingTasks|default([])|length }}</div></div>
            <div class="stat-card"><div class="stat-label">En cours</div><div class="stat-value" style="color:#3b82f6">{{ myInProgressTasks|default([])|length }}</div></div>
            <div class="stat-card"><div class="stat-label">Terminées</div><div class="stat-value" style="color:#10b981">{{ myCompletedTasks|default([])|length }}</div></div>
            <div class="stat-card"><div class="stat-label">En retard</div><div class="stat-value" style="color:#ef4444">{{ myOverdueTasks|default([])|length }}</div></div>
        </div>
        
        {% if myPendingTasks|default([])|length > 0 %}
        <div class="network-card">
            <h3>⏳ Tâches en attente</h3>
            {% for task in myPendingTasks|slice(0, 5) %}
            <div class="network-item">
                <div><strong>#{{ task.ticket.id }}</strong> - {{ task.title }}</div>
                <div><span class="badge badge-pending">⏳ En attente</span></div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    {% endif %}

    {# ==================== GC / DÉPLOIEMENT ==================== #}
    {% if role == 'gc' %}
        <div class="network-card">
            <h3>🏗️ Projets GC en cours</h3>
            <div class="network-item">Aucun projet pour le moment</div>
        </div>
    {% endif %}

    {% if role == 'deploiement' %}
        <div class="network-card">
            <h3>🚀 Sites 5G en déploiement</h3>
            <div class="network-item">Aucun site en déploiement</div>
        </div>
    {% endif %}

{% endblock %}

{% block javascripts %}
    {# Scripts pour SUPERUSER #}
    {% if role == 'superuser' %}
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            window.sitesData = {{ sites_gps|json_encode|raw }};
            window.statsFO   = {{ stats.fo|default(0) }};
            window.statsFH   = {{ stats.fh|default(0) }};
            window.statsBackbone = {{ stats.backbone|default(0) }};
            window.mapSelectionExportUrl = {{ path('export_map_selection_excel')|json_encode|raw }};
        </script>
        <script src="{{ asset('js/dashboard/map.js') }}"></script>

        {# Script IA - Détection d'anomalies - CORRIGÉ #}
        <script>
        // Vérifier le statut de l'API IA
        async function checkIaStatus() {
            try {
                const response = await fetch('/ia/status');
                const data = await response.json();
                const badge = document.getElementById('iaStatusBadge');
                if (badge) {
                    if (data.available) {
                        badge.className = 'badge bg-success ms-2';
                        badge.style.fontSize = '10px';
                        badge.innerHTML = '<i class="fas fa-check-circle"></i> IA active';
                    } else {
                        badge.className = 'badge bg-danger ms-2';
                        badge.style.fontSize = '10px';
                        badge.innerHTML = '<i class="fas fa-exclamation-triangle"></i> IA inactive';
                    }
                }
                return data.available;
            } catch (error) {
                console.error('Erreur statut IA:', error);
                const badge = document.getElementById('iaStatusBadge');
                if (badge) {
                    badge.className = 'badge bg-danger ms-2';
                    badge.innerHTML = '<i class="fas fa-exclamation-triangle"></i> IA indisponible';
                }
                return false;
            }
        }

        // Charger les anomalies IA depuis l'API
        async function loadIaAnomalies() {
            const container = document.getElementById('iaAnomaliesList');
            if (!container) return;
            
            try {
                const response = await fetch('/ia/anomalies/recentes');
                const data = await response.json();
                
                if (data.status === 'success' && data.anomalies && data.anomalies.length > 0) {
                    // Afficher les anomalies
                    let html = `
                        <div class="mb-2 pb-2 border-bottom">
                            <small class="text-muted">
                                <i class="fas fa-chart-line"></i> ${data.total} anomalies détectées aujourd'hui
                            </small>
                        </div>
                    `;
                    
                    data.anomalies.forEach(a => {
                        let priorityClass = '';
                        let priorityIcon = '';
                        let bgColor = '';
                        
                        if (a.priorite === 'URGENTE') {
                            priorityClass = 'danger';
                            priorityIcon = 'fa-skull-crosswalk';
                            bgColor = '#fef2f2';
                        } else if (a.priorite === 'HAUTE') {
                            priorityClass = 'warning';
                            priorityIcon = 'fa-exclamation-triangle';
                            bgColor = '#fffbeb';
                        } else {
                            priorityClass = 'secondary';
                            priorityIcon = 'fa-info-circle';
                            bgColor = '#f8fafc';
                        }
                        
                        html += `
                            <div class="network-item mb-2" style="border-left: 3px solid var(--${priorityClass}); background: ${bgColor}; border-radius: 8px; padding: 12px; margin-bottom: 8px;">
                                <div style="flex: 1;">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <i class="fas ${priorityIcon} text-${priorityClass}" style="font-size: 12px;"></i>
                                        <strong style="font-size: 13px;">${escapeHtml(a.site)}</strong>
                                        <span class="badge bg-${priorityClass}" style="font-size: 9px;">${escapeHtml(a.priorite)}</span>
                                    </div>
                                    <div class="text-muted small" style="font-size: 10px;">
                                        <i class="far fa-clock"></i> ${formatDate(a.date_alerte)}
                                    </div>
                                    <div class="small mt-1" style="font-size: 11px;">
                                        ${escapeHtml(a.message || a.type_anomalie || 'Anomalie détectée')}
                                    </div>
                                </div>
                                <div class="text-end">
                                    ${a.trafic_j ? `<div class="small fw-bold">${a.trafic_j} Mbps</div>` : ''}
                                    ${a.taux_utilisation ? `<div class="small ${a.taux_utilisation > 80 ? 'text-danger' : 'text-muted'}">${a.taux_utilisation}%</div>` : ''}
                                </div>
                            </div>
                        `;
                    });
                    
                    container.innerHTML = html;
                } else {
                    // Aucune anomalie
                    container.innerHTML = `
                        <div class="text-center py-4">
                            <i class="fas fa-check-circle fa-3x mb-3" style="color: #10b981;"></i>
                            <p class="text-muted mb-0">Aucune anomalie IA détectée aujourd'hui</p>
                            <small class="text-muted">Le trafic réseau est stable</small>
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Erreur chargement anomalies IA:', error);
                container.innerHTML = `
                    <div class="text-center py-4 text-danger">
                        <i class="fas fa-exclamation-circle fa-3x mb-3"></i>
                        <p>Erreur de connexion à l'API IA</p>
                        <button class="btn btn-sm btn-outline-danger mt-2" onclick="loadIaAnomalies()">
                            <i class="fas fa-sync-alt"></i> Réessayer
                        </button>
                    </div>
                `;
            }
        }

        // Formater la date
        function formatDate(dateString) {
            if (!dateString) return 'Date inconnue';
            try {
                const date = new Date(dateString);
                return date.toLocaleString('fr-FR', {
                    day: '2-digit',
                    month: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit'
                });
            } catch(e) {
                return dateString;
            }
        }

        // Échapper le HTML
        function escapeHtml(str) {
            if (!str) return '';
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // Initialisation au chargement de la page
        document.addEventListener('DOMContentLoaded', function() {
            // Charger les anomalies IA
            loadIaAnomalies();
            
            // Vérifier le statut IA
            checkIaStatus();
            
            // Bouton d'actualisation
            const refreshBtn = document.getElementById('refreshIaAnomalies');
            if (refreshBtn) {
                refreshBtn.addEventListener('click', function() {
                    const container = document.getElementById('iaAnomaliesList');
                    if (container) {
                        container.innerHTML = `
                            <div class="text-center py-4">
                                <div class="spinner-border text-warning" role="status" style="width: 30px; height: 30px;"></div>
                                <p class="mt-2 text-muted small">Actualisation...</p>
                            </div>
                        `;
                    }
                    loadIaAnomalies();
                    checkIaStatus();
                });
            }
            
            // Rafraîchir toutes les 5 minutes
            setInterval(function() {
                loadIaAnomalies();
                checkIaStatus();
            }, 300000);
        });
        </script>
    {% endif %}
    
    {# Scripts pour CONTRÔLEUR #}
    {% if role == 'controleur' %}
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const govData = {{ statsByGouvernorat|json_encode|raw }};
                const govCtx = document.getElementById('govChart');
                if (govCtx && govData.length > 0) {
                    new Chart(govCtx, {
                        type: 'bar',
                        data: {
                            labels: govData.map(d => d.gouvernorat),
                            datasets: [
                                { label: 'Congestionnés', data: govData.map(d => d.congestionnes || 0), backgroundColor: '#ef4444', borderRadius: 6, barPercentage: 0.7 },
                                { label: 'Bridés', data: govData.map(d => d.brides || 0), backgroundColor: '#f59e0b', borderRadius: 6, barPercentage: 0.7 }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                x: { ticks: { font: { size: 10 }, maxRotation: 35 }, grid: { display: false } },
                                y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 10 } }, grid: { color: '#e2e8f0' } }
                            }
                        }
                    });
                }

                const healthCtx = document.getElementById('healthChart');
                if (healthCtx) {
                    new Chart(healthCtx, {
                        type: 'doughnut',
                        data: {
                            labels: ['OK', 'Congestionnés', 'Bridés'],
                            datasets: [{
                                data: [{{ siteHealthStats.ok|default(0) }}, {{ siteHealthStats.congestionnes|default(0) }}, {{ siteHealthStats.brides|default(0) }}],
                                backgroundColor: ['#10b981', '#ef4444', '#f59e0b'],
                                borderWidth: 3,
                                borderColor: '#fff',
                                hoverOffset: 8,
                                cutout: '65%'
                            }]
                        },
                        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
                    });
                }

                const trafficData = {{ trafficData|default([])|json_encode|raw }};
                const trafficCtx = document.getElementById('trafficChart');
                if (trafficCtx) {
                    let labels, traficVals, capaciteVals;
                    if (trafficData && trafficData.length > 0) {
                        labels = trafficData.map(d => d.jour);
                        traficVals = trafficData.map(d => parseFloat(d.trafic_mbps || d.trafic_gbps || 0));
                        capaciteVals = trafficData.map(d => parseFloat(d.capacite || 0));
                    } else {
                        labels = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
                        traficVals = [3200, 4100, 5900, 6400, 5200, 4100, 3600];
                        capaciteVals = [8000, 8000, 8000, 8000, 8000, 8000, 8000];
                    }
                    new Chart(trafficCtx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [
                                { label: 'Trafic entrant (Mbps)', data: traficVals, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.05)', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#3b82f6', pointBorderColor: '#fff', borderWidth: 2 },
                                { label: 'Capacité', data: capaciteVals, borderColor: 'rgba(16,185,129,0.4)', backgroundColor: 'rgba(16,185,129,0.02)', fill: true, borderDash: [6, 4], pointRadius: 0, borderWidth: 1.5 }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': ' + Math.round(ctx.parsed.y).toLocaleString('fr-FR') + ' Mbps' } } },
                            scales: { x: { ticks: { font: { size: 11 } }, grid: { display: false } }, y: { beginAtZero: true, ticks: { callback: v => v >= 1000 ? (v/1000).toFixed(1) + 'G' : v, font: { size: 10 } }, grid: { color: '#e2e8f0' } } }
                        }
                    });
                }
            });
        </script>
    {% endif %}
{% endblock %}