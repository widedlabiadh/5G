{# templates/dashboard/_transmission_table.html.twig #}
{# Template partagé par FO, FH, Backhaul Sharing et TOUS #}

{% extends 'base.html.twig' %}

{% block title %}{{ titre }} — NetWON{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.main {
    margin-left: var(--sidebar-width);
    padding: 1.8rem 2rem !important;
}
    /* STATS CARTES STYLE IMAGE */
    .stats-grid-modern {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 2rem;
    }
    
    .stat-card-modern {
        background: white;
        border-radius: 20px;
        padding: 1.2rem 1.2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid #eef2f9;
        transition: all 0.2s ease;
    }
    
    .stat-card-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        border-color: #FF6600;
    }
    
    .stat-card-modern .stat-title {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #94a3b8;
        margin-bottom: 12px;
    }
    
    .stat-card-modern .stat-value {
        font-size: 32px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.2;
        margin-bottom: 8px;
    }
    
    .stat-card-modern .stat-value small {
        font-size: 14px;
        font-weight: 500;
        color: #94a3b8;
    }
    
    .stat-card-modern .stat-footer {
        font-size: 12px;
        color: #64748b;
        border-top: 1px solid #f1f5f9;
        padding-top: 10px;
        margin-top: 8px;
    }
    
    .stat-card-modern.max .stat-value { color: #FF6600; }
    .stat-card-modern.critique .stat-value { color: #dc2626; }
    .stat-card-modern.capacity .stat-value { color: #3b82f6; }
    
    /* CLASSIFICATION BADGES */
    .class-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
        text-align: center;
        background: #f1f5f9;
        color: #475569;
    }
    .class-badge.tf { background: #fff3cd; color: #856404; }
    .class-badge.cotrans { background: #d1fae5; color: #065f46; }
    .class-badge.nocotrans { background: #dbeafe; color: #1e40af; }
    .class-badge.nontdd { background: #f1f5f9; color: #475569; }
    .class-badge.fdd,
    .class-badge.onlyfdd { background: #e0f2fe; color: #0369a1; }

    /* STATUT BADGES */
    .statut-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 30px;
        font-size: 10px;
        font-weight: 700;
        text-align: center;
    }
    .statut-badge.critique { background: #fee2e2; color: #dc2626; }
    .statut-badge.surveillance { background: #fef3c7; color: #d97706; }
    .statut-badge.ok { background: #dcfce7; color: #16a34a; }
    .statut-badge.aucune { background: #f1f5f9; color: #64748b; }

    /* ETAT BADGES - NOUVEAU */
    .etat-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 30px;
        font-size: 10px;
        font-weight: 700;
        text-align: center;
    }
    .etat-badge.congestion     { background: #fee2e2; color: #dc2626; }
    .etat-badge.congestion-fdd { background: #fee2e2; color: #b91c1c; }
    .etat-badge.congestion-tdd { background: #fee2e2; color: #b91c1c; }
    .etat-badge.risque         { background: #fef3c7; color: #b45309; }
    .etat-badge.bridage        { background: #fef3c7; color: #d97706; }
    .etat-badge.bridage-fdd    { background: #fef3c7; color: #b45309; }
    .etat-badge.bridage-tdd    { background: #fef3c7; color: #b45309; }
    .etat-badge.ok             { background: #dcfce7; color: #16a34a; }

    /* FILTRES */
    .filters-bar {
        background: white;
        border-radius: 16px;
        padding: 12px 20px;
        margin-bottom: 1.5rem;
        border: 1px solid #eef2f9;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
    }
    
    .date-range-picker {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f8fafc;
        padding: 4px 12px;
        border-radius: 40px;
        border: 1px solid #e2e8f0;
    }
    
    .date-range-picker input {
        border: none;
        background: transparent;
        padding: 8px 4px;
        font-size: 13px;
        width: 110px;
        outline: none;
    }
    
    .periode-badge {
        background: #FF6600;
        color: white;
        padding: 4px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 500;
    }
    
    /* TABLE */
    .table-wrapper {
        background: white;
        border-radius: 20px;
        border: 1px solid #eef2f9;
        overflow: hidden;
    }
    
    .table-header {
        padding: 16px 20px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .table-header h3 {
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
        margin: 0;
    }
    
    .btn-export {
        background: #FF6600;
        color: white;
        border: none;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }
    
    .btn-export:hover {
        background: #e55a00;
        color: white;
        transform: translateY(-1px);
    }
    
    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    
    .data-table th {
        background: #f8fafc;
        padding: 12px 16px;
        text-align: left;
        font-weight: 600;
        color: #64748b;
        border-bottom: 1px solid #eef2f9;
    }
    
    .data-table td {
        padding: 12px 16px;
        border-bottom: 1px solid #f8fafc;
        color: #334155;
    }
    
    .data-table tr:hover td {
        background: #fafcff;
    }
    
    .occurrence-high { color: #dc2626; font-weight: 700; }
    .occurrence-med { color: #f97316; font-weight: 600; }
    .occurrence-ok { color: #22c55e; font-weight: 500; }
    
    .capacity-badge {
        background: #e2e8f0;
        padding: 2px 10px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 600;
        color: #475569;
    }
    
    .utilization-high { background: #fee2e2; color: #dc2626; }
    .utilization-med { background: #fef3c7; color: #d97706; }
    .utilization-low { background: #dcfce7; color: #16a34a; }
    
    .utilization-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 600;
    }
    
    .page-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #0f172a;
    }
    
    .page-title span {
        background: linear-gradient(135deg, #FF6600, #ea580c);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    
    /* SITE NAME CLEAN - PAS DE PREFIX */
    .site-name {
        font-family: monospace;
        font-weight: 600;
        font-size: 12px;
    }
    
    /* TEXT RIGHT ALIGN */
    .text-end {
        text-align: right;
    }
    .text-center {
        text-align: center;
    }
    
    /* VALEURS EXACTES SANS ARRONDI */
    .value-exact {
        font-family: monospace;
        font-size: 12px;
    }
</style>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title">
                {% if type == 'FO' %}📡{% elseif type == 'FH' %}🔗{% elseif type == 'BACKBONE' %}🌐{% else %}📊{% endif %}
                Plan Data <span>{% if type == 'TOUS' %}Global{% else %}{{ titre }}{% endif %}</span>
            </h1>
            <p class="text-muted small mt-1 mb-0">
                Analyse du {{ derniere_date_import ? derniere_date_import|date('d/m/Y') : 'N/A' }}
            </p>
        </div>
        <div class="bg-white px-3 py-2 rounded-3 border">
            <i class="fas fa-user-circle me-2 text-warning"></i>
            <span class="small fw-semibold">{{ user.fullName ?? user.email }}</span>
        </div>
    </div>

    <!-- FILTRES -->
    <form method="GET" class="filters-bar">
        <input type="text" name="search" placeholder="🔍 Rechercher un site..." value="{{ search }}" class="form-control form-control-sm" style="width: 200px;">
        
        <div class="date-range-picker">
            <i class="fas fa-calendar-alt text-warning"></i>
            <input type="text" name="date_debut" id="date_debut" value="{{ date_debut }}" placeholder="Début" autocomplete="off">
            <span>—</span>
            <input type="text" name="date_fin" id="date_fin" value="{{ date_fin }}" placeholder="Fin" autocomplete="off">
            <button type="submit" class="btn btn-sm btn-warning px-3" style="border-radius: 30px;">OK</button>
        </div>
        
        <select name="classification" class="form-select form-select-sm" style="width: 150px;">
            <option value="">Toutes classifications</option>
            <option value="TF" {{ classFilter == 'TF' ? 'selected' : '' }}>TF</option>
            <option value="COTRANS" {{ classFilter == 'COTRANS' ? 'selected' : '' }}>COTRANS</option>
            <option value="NO_COTRANS" {{ classFilter == 'NO_COTRANS' ? 'selected' : '' }}>NO_COTRANS</option>
            <option value="ONLY_FDD" {{ classFilter == 'ONLY_FDD' ? 'selected' : '' }}>Only FDD</option>
        </select>
        
        <a href="{{ app.request.pathInfo }}" class="btn btn-sm btn-light border">Réinitialiser</a>
        
        <span class="text-muted small ms-auto">{{ total|default(sites|length) }} site(s)</span>
    </form>


    <!-- TABLEAU -->
    <div class="table-wrapper">
        <div class="table-header">
            <h3>
                <i class="fas fa-table me-2 text-warning"></i>
                Résultats détaillés
                {% if date_debut and date_fin %}
                    <span class="periode-badge ms-2">
                        {{ date_debut|date('d/m/Y') }} → {{ date_fin|date('d/m/Y') }}
                    </span>
                {% endif %}
            </h3>
            <a href="{{ path('export_transmission_excel', { type: type, search: search, classification: classFilter, date_debut: date_debut, date_fin: date_fin }) }}" class="btn-export">
                📊 Exporter Excel
            </a>
        </div>
        
        {% if sites|length == 0 %}
            <div class="text-center py-5 text-muted">
                <i class="fas fa-database fa-3x mb-3 opacity-25"></i>
                <p>Aucun site trouvé pour cette catégorie.</p>
            </div>
        {% else %}
        <div class="table-responsive">
            <table class="data-table" id="mainTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Site</th>
                        <th>Classification</th>
                        <th>Type</th>
                        <th class="text-end">Max TDD</th>
                        <th class="text-end">Max FDD</th>
                        <th class="text-end">Trafic Max</th>
                        <th class="text-end">Capacité TDD (Mbps)</th>
                        <th class="text-end">Capacité FDD (Mbps)</th>
                        <th class="text-end">Taux Util.</th>
                        <th class="text-end">Taux TDD</th>
                        <th class="text-end">Taux FDD</th>
                        <th class="text-center">Occurrences</th>
                        <th class="text-center">Occurrence TDD</th>
                        <th class="text-center">Occurrence FDD</th>
                        <th class="text-center">Statut</th>
                        <th class="text-center">État</th>
                        <th class="text-center">DropCong (tdd)</th>
                        <th class="text-center">DropCong (fdd)</th>
                        <th class="text-center">DropCong (tf)</th>
                        <th>Date Max</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                {% for s in sites %}
                    {% set maxTdd = s.max_tdd|default(0) %}
                    {% set maxFdd = s.max_fdd|default(0) %}
                    {% set maxTrafic = s.max_trafic|default(0) %}
                    {% set occurrences = s.nombre_occurrences|default(0) %}
                    {% set occurrencesTdd = s.nombre_occurrences_tdd|default(0) %}
                    {% set occurrencesFdd = s.nombre_occurrences_fdd|default(0) %}
                    {% set capacityTdd = s.capacite_tdd_mbps|default(0) %}
                    {% set capacityFdd = s.capacite_fdd_mbps|default(0) %}
                    {% set capacityTotal = s.capacite_mbps|default(0) %}
                    {% if capacityTotal <= 0 %}
                        {% set capacityTotal = capacityFdd > 0 ? capacityFdd : (capacityTdd + capacityFdd) %}
                    {% endif %}
                    {% set dureeSite = s.duree_jours|default(7) %}
                    {% set seuilObservation = s.seuil_observation|default(((20 * dureeSite) / 7)|round(0, 'ceil')) %}
                    {% set seuilCritique = s.seuil_critique|default(((50 * dureeSite) / 7)|round(0, 'ceil')) %}
                    {% set statut = s.statut|default('OK') %}
                    {% set statutLabel = s.statut_label|default(statut == 'SOUS_OBSERVATION' ? 'SOUS OBSERVATION' : statut) %}
                    {% set etat = s.etat|default('OK') %}
                    {% set dropcongTdd = s.dropcong_tdd|default(0) %}
                    {% set dropcongFdd = s.dropcong_fdd|default(0) %}
                    {% set dropcongTf = s.dropcong_tf|default(0) %}
                    
                    {# Taux d'utilisation #}
                    {% set clsForTaux = s.classification|default('')|upper|replace({' ': '', '\t': ''}) %}
                    {% set isCotrans = 'COTRANS' in clsForTaux %}
                    {# COTRANS/NO_COTRANS : taux global toujours vide — seuls taux TDD et FDD sont affichés #}
                    {% if isCotrans %}
                        {% set tauxGlobal = null %}
                    {% else %}
                        {% set tauxGlobal = s.taux_utilisation is defined and s.taux_utilisation is not null ? s.taux_utilisation + 0 : null %}
                        {% if tauxGlobal is null and capacityTotal > 0 and maxTrafic > 0 %}
                            {% set tauxGlobal = (maxTrafic / capacityTotal) * 100 %}
                        {% endif %}
                    {% endif %}
                    
                    {% set tauxTdd = s.taux_utilisation_tdd is defined and s.taux_utilisation_tdd is not null ? s.taux_utilisation_tdd + 0 : null %}
                    {% if tauxTdd is null and capacityTdd > 0 and maxTdd > 0 %}
                        {% set tauxTdd = (maxTdd / capacityTdd) * 100 %}
                    {% endif %}
                    
                    {% set tauxFdd = s.taux_utilisation_fdd is defined and s.taux_utilisation_fdd is not null ? s.taux_utilisation_fdd + 0 : null %}
                    {% if tauxFdd is null and capacityFdd > 0 and maxFdd > 0 %}
                        {% set tauxFdd = (maxFdd / capacityFdd) * 100 %}
                    {% endif %}

                    {% set risqueCongestion = (
                        (tauxGlobal is not null and tauxGlobal >= 90 and occurrences < 57)
                        or (tauxTdd is not null and tauxTdd >= 90 and occurrencesTdd < 57)
                        or (tauxFdd is not null and tauxFdd >= 90 and occurrencesFdd < 57)
                    ) %}
                    {% if risqueCongestion %}
                        {% set statut = 'SOUS_OBSERVATION' %}
                        {% set statutLabel = 'SOUS OBSERVATION' %}
                        {% set etat = 'RISQUE_DE_CONGESTION' %}
                    {% endif %}
                    
                    {% set statutClass = '' %}
                    {% if statut == 'CRITIQUE' %}
                        {% set statutClass = 'critique' %}
                    {% elseif statut in ['SOUS_OBSERVATION', 'SURVEILLANCE'] %}
                        {% set statutClass = 'surveillance' %}
                    {% elseif statut == 'OK' %}
                        {% set statutClass = 'ok' %}
                    {% else %}
                        {% set statutClass = 'aucune' %}
                    {% endif %}
                    
                    {% set etatClass = '' %}
                    {% if etat == 'CONGESTION' %}
                        {% set etatClass = 'congestion' %}
                    {% elseif etat == 'CONGESTION(FDD)' %}
                        {% set etatClass = 'congestion-fdd' %}
                    {% elseif etat == 'CONGESTION(TDD)' %}
                        {% set etatClass = 'congestion-tdd' %}
                    {% elseif etat == 'RISQUE_DE_CONGESTION' %}
                        {% set etatClass = 'risque' %}
                    {% elseif etat == 'BRIDAGE' %}
                        {% set etatClass = 'bridage' %}
                    {% elseif etat == 'BRIDAGE(FDD)' %}
                        {% set etatClass = 'bridage-fdd' %}
                    {% elseif etat == 'BRIDAGE(TDD)' %}
                        {% set etatClass = 'bridage-tdd' %}
                    {% else %}
                        {% set etatClass = 'ok' %}
                    {% endif %}
                    
                    <tr>
                        <td class="text-muted">{{ ((page|default(1) - 1) * limit|default(50)) + loop.index }}</td>
                        <td>
                            <strong class="site-name">
                                {{ s.site|clean_site }}
                            </strong>
                        </td>
                        <td>
                            {% set clsRaw = s.classification_display|default(s.classification)|upper|trim %}
                            {% set cls = clsRaw in ['ONLY FDD', 'ONLY_FDD', 'FDD', '-'] ? 'ONLY_FDD' : clsRaw %}
                            {% set clsLabel = cls == 'ONLY_FDD' ? 'ONLY FDD' : cls|replace({'_': ' '}) %}
                            <span class="class-badge {{ cls|lower|replace({'_':''}) }}">{{ clsLabel }}</span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark fw-semibold">
                                {{ s.type_trans|default('only FDD') == '-' ? 'only FDD' : s.type_trans|default('only FDD') }}
                            </span>
                        </td>
                        <td class="text-end value-exact">
                            {% if maxTdd > 0 %}
                                {{ maxTdd|replace({'.': ','}) }}
                            {% else %}
                                0
                            {% endif %}
                        </td>
                        <td class="text-end value-exact">
                            {% if maxFdd > 0 %}
                                {{ maxFdd|replace({'.': ','}) }}
                            {% else %}
                                0
                            {% endif %}
                        </td>
                        <td class="text-end fw-bold value-exact">
                            {% if maxTrafic > 0 %}
                                {{ maxTrafic|replace({'.': ','}) }}
                            {% else %}
                                0
                            {% endif %}
                        </td>
                        <td class="text-end">
                            {% if capacityTdd > 0 %}
                                <span class="capacity-badge">{{ (capacityTdd + 0)|replace({'.': ','}) }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            {% if capacityFdd > 0 %}
                                <span class="capacity-badge">{{ (capacityFdd + 0)|replace({'.': ','}) }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            {% if tauxGlobal is not null and not isCotrans %}
                                {% if tauxGlobal >= 90 %}
                                    <span class="utilization-badge utilization-high">{{ tauxGlobal|number_format(2, ',', ' ') }}%</span>
                                {% elseif tauxGlobal > 70 %}
                                    <span class="utilization-badge utilization-med">{{ tauxGlobal|number_format(2, ',', ' ') }}%</span>
                                {% else %}
                                    <span class="utilization-badge utilization-low">{{ tauxGlobal|number_format(2, ',', ' ') }}%</span>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            {% if tauxTdd is not null %}
                                {% if tauxTdd >= 90 %}
                                    <span class="utilization-badge utilization-high">{{ tauxTdd|number_format(2, ',', ' ') }}%</span>
                                {% elseif tauxTdd > 70 %}
                                    <span class="utilization-badge utilization-med">{{ tauxTdd|number_format(2, ',', ' ') }}%</span>
                                {% else %}
                                    <span class="utilization-badge utilization-low">{{ tauxTdd|number_format(2, ',', ' ') }}%</span>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            {% if tauxFdd is not null %}
                                {% if tauxFdd >= 90 %}
                                    <span class="utilization-badge utilization-high">{{ tauxFdd|number_format(2, ',', ' ') }}%</span>
                                {% elseif tauxFdd > 70 %}
                                    <span class="utilization-badge utilization-med">{{ tauxFdd|number_format(2, ',', ' ') }}%</span>
                                {% else %}
                                    <span class="utilization-badge utilization-low">{{ tauxFdd|number_format(2, ',', ' ') }}%</span>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <span class="{% if occurrences >= seuilCritique %}occurrence-high{% elseif occurrences >= seuilObservation %}occurrence-med{% else %}occurrence-ok{% endif %}">
                                {{ occurrences }}
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="{% if occurrencesTdd >= seuilCritique %}occurrence-high{% elseif occurrencesTdd >= seuilObservation %}occurrence-med{% else %}occurrence-ok{% endif %}">
                                {{ occurrencesTdd }}
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="{% if occurrencesFdd >= seuilCritique %}occurrence-high{% elseif occurrencesFdd >= seuilObservation %}occurrence-med{% else %}occurrence-ok{% endif %}">
                                {{ occurrencesFdd }}
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="statut-badge {{ statutClass }}">
                                {% if statut == 'CRITIQUE' %}
                                    🔴 {{ statutLabel }}
                                {% elseif statut in ['SOUS_OBSERVATION', 'SURVEILLANCE'] %}
                                    🟠 {{ statutLabel }}
                                {% elseif statut == 'OK' %}
                                    🟢 OK
                                {% else %}
                                    ⚪ AUCUNE
                                {% endif %}
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="etat-badge {{ etatClass }}">
                                {% if etat == 'CONGESTION' %}
                                    🔴 CONGESTION
                                {% elseif etat == 'CONGESTION(FDD)' %}
                                    🔴 CONGESTION (FDD)
                                {% elseif etat == 'CONGESTION(TDD)' %}
                                    🔴 CONGESTION (TDD)
                                {% elseif etat == 'RISQUE_DE_CONGESTION' %}
                                    RISQUE DE CONGESTION
                                {% elseif etat == 'BRIDAGE' %}
                                    🟠 BRIDAGE
                                {% elseif etat == 'BRIDAGE(FDD)' %}
                                    🟠 BRIDAGE (FDD)
                                {% elseif etat == 'BRIDAGE(TDD)' %}
                                    🟠 BRIDAGE (TDD)
                                {% else %}
                                    🟢 OK
                                {% endif %}
                            </span>
                        </td>
                        <td class="text-center">{{ dropcongTdd }}</td>
                        <td class="text-center">{{ dropcongFdd }}</td>
                        <td class="text-center">{{ dropcongTf }}</td>
                        <td class="small text-muted">{{ s.date_max ? s.date_max|date('d/m/Y H:i') : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
        
        <!-- PAGINATION -->
        <div class="d-flex justify-content-center py-3" id="pagination"></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
<script>
// Pagination
const ROWS_PER_PAGE = 50;
const tbody = document.getElementById('tableBody');
const pagination = document.getElementById('pagination');

if (tbody && pagination && tbody.rows.length > 0) {
    const rows = Array.from(tbody.rows);
    const total = rows.length;
    const pages = Math.ceil(total / ROWS_PER_PAGE);
    let current = 1;

    function showPage(page) {
        current = page;
        rows.forEach((row, i) => {
            row.style.display = (i >= (page-1)*ROWS_PER_PAGE && i < page*ROWS_PER_PAGE) ? '' : 'none';
        });
        renderPagination();
    }

    function renderPagination() {
        if (pages <= 1) return;
        let html = '';
        const start = Math.max(1, current - 2);
        const end = Math.min(pages, current + 2);

        if (current > 1) html += `<button class="btn btn-sm btn-outline-secondary me-1" onclick="showPage(${current-1})">‹</button>`;
        if (start > 1) html += `<button class="btn btn-sm btn-outline-secondary me-1" onclick="showPage(1)">1</button><span class="mx-1">…</span>`;

        for (let i = start; i <= end; i++) {
            html += `<button class="btn btn-sm ${i===current ? 'btn-warning' : 'btn-outline-secondary'} me-1" onclick="showPage(${i})">${i}</button>`;
        }

        if (end < pages) html += `<span class="mx-1">…</span><button class="btn btn-sm btn-outline-secondary" onclick="showPage(${pages})">${pages}</button>`;
        if (current < pages) html += `<button class="btn btn-sm btn-outline-secondary ms-1" onclick="showPage(${current+1})">›</button>`;

        pagination.innerHTML = html;
    }

    showPage(1);
}

// Date Picker
flatpickr("#date_debut", {
    dateFormat: "Y-m-d",
    locale: "fr",
    allowInput: true,
    onChange: function(selectedDates, dateStr) {
        if (dateStr) {
            flatpickr("#date_fin", {
                dateFormat: "Y-m-d",
                locale: "fr",
                minDate: dateStr,
                allowInput: true
            });
        }
    }
});

flatpickr("#date_fin", {
    dateFormat: "Y-m-d",
    locale: "fr",
    allowInput: true
});
</script>
{% endblock %}
