<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Dashboard Ingénierie FH — Orange Tunisie</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f5f5f5; }
        .sidebar {
            width: 250px; background: #1a1a2e; height: 100vh;
            position: fixed; left: 0; top: 0;
            display: flex; flex-direction: column; padding: 1.5rem;
        }
        .logo { display: flex; align-items: center; gap: 12px; margin-bottom: 2rem; }
        .logo-circle {
            width: 42px; height: 42px; background: #FF6600;
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; font-weight: 700; color: white; font-size: 18px;
        }
        .logo-text { color: white; font-size: 14px; font-weight: 500; }
        .logo-sub { color: #aaa; font-size: 11px; }
        .nav-section {
            font-size: 10px; color: #666;
            text-transform: uppercase; letter-spacing: 1px;
            margin: 1.5rem 0 0.5rem;
        }
        .nav-item {
            display: flex; align-items: center; gap: 10px;
            padding: 0.6rem 0.8rem; border-radius: 8px;
            color: #ccc; text-decoration: none; font-size: 13px;
            margin-bottom: 2px; transition: all 0.2s;
        }
        .nav-item:hover, .nav-item.active { background: #FF6600; color: white; }
        .main { margin-left: 250px; padding: 2rem; }
        .topbar {
            display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 2rem;
        }
        .topbar h1 { font-size: 20px; font-weight: 500; color: #333; }
        .user-badge {
            display: flex; align-items: center; gap: 10px;
            background: white; padding: 0.5rem 1rem;
            border-radius: 20px; border: 1px solid #eee;
            font-size: 13px; color: #555;
        }
        .avatar {
            width: 32px; height: 32px; background: #006633;
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; color: white; font-size: 11px; font-weight: 600;
        }
        .stats-grid {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 16px; margin-bottom: 2rem;
        }
        .stat-card {
            background: white; border-radius: 10px;
            padding: 1.2rem; border: 1px solid #eee;
        }
        .stat-label { font-size: 12px; color: #888; margin-bottom: 6px; }
        .stat-value { font-size: 26px; font-weight: 600; color: #333; }
        .stat-sub { font-size: 11px; color: #aaa; margin-top: 4px; }
        .section-title { font-size: 15px; font-weight: 500; color: #333; margin-bottom: 1rem; }
        .three-cols { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 2rem; }
        .two-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .info-card {
            background: white; border-radius: 10px;
            border: 1px solid #eee; padding: 1.5rem;
            border-top: 4px solid #006633;
        }
        .info-card h3 { font-size: 14px; font-weight: 500; color: #333; margin-bottom: 1rem; }
        .info-row {
            display: flex; justify-content: space-between;
            padding: 0.5rem 0; border-bottom: 1px solid #f5f5f5; font-size: 13px;
        }
        .info-row:last-child { border-bottom: none; }
        .info-label { color: #888; }
        .info-value { font-weight: 500; color: #333; }
        .plan-card {
            background: white; border-radius: 10px;
            border: 1px solid #eee; padding: 1.5rem;
            border-left: 4px solid #FF6600;
        }
        .plan-card h3 { font-size: 14px; font-weight: 500; color: #333; margin-bottom: 1rem; }
        .plan-item {
            display: flex; align-items: flex-start; gap: 10px;
            padding: 0.6rem 0; border-bottom: 1px solid #f5f5f5; font-size: 13px;
        }
        .plan-item:last-child { border-bottom: none; }
        .plan-num {
            width: 22px; height: 22px; background: #FF6600;
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; color: white; font-size: 11px;
            font-weight: 600; flex-shrink: 0;
        }
        .plan-text { color: #555; line-height: 1.4; }
        .logout-btn {
            margin-top: auto; display: flex; align-items: center; gap: 10px;
            padding: 0.6rem 0.8rem; border-radius: 8px;
            color: #ccc; text-decoration: none; font-size: 13px; transition: all 0.2s;
        }
        .logout-btn:hover { background: #cc0000; color: white; }
    </style>
</head>
<body>
<div class="sidebar">
    <div class="logo">
        <div class="logo-circle">O</div>
        <div>
            <div class="logo-text">Orange Tunisie</div>
            <div class="logo-sub">Transmission Monitor</div>
        </div>
    </div>
    <span class="nav-section">Ingénierie FH</span>
    <a href="#" class="nav-item active">🏠 Dashboard</a>
    <a href="#" class="nav-item">📊 Analyse Trafic</a>
    <a href="#" class="nav-item">🤖 Prévisions IA</a>
    <span class="nav-section">Planification</span>
    <a href="#" class="nav-item">📡 Sites FH</a>
    <a href="#" class="nav-item">⚙️ Capacité</a>
    <a href="#" class="nav-item">📋 Plan d'action</a>
    <span class="nav-section">Rapports</span>
    <a href="#" class="nav-item">📅 Journalier</a>
    <a href="#" class="nav-item">📅 Hebdomadaire</a>
    <a href="#" class="nav-item">📅 Mensuel</a>
    <a href="#" class="nav-item">🕐 Historique</a>
    <a href="{{ path('app_logout') }}" class="logout-btn">🚪 Déconnexion</a>
</div>
<div class="main">
    <div class="topbar">
        <h1>Dashboard Ingénierie Faisceaux Hertziens</h1>
        <div class="user-badge">
            <div class="avatar">IFH</div>
            {{ user.fullName ?? user.email }} 
        </div>
    </div>
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Sites FH total</div>
            <div class="stat-value">—</div>
            <div class="stat-sub">Sous surveillance</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Congestions</div>
            <div class="stat-value" style="color:#cc0000">0</div>
            <div class="stat-sub">Seuil 90% dépassé</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Prévision J+7</div>
            <div class="stat-value" style="color:#FF6600">—</div>
            <div class="stat-sub">Estimation trafic</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Sites critiques</div>
            <div class="stat-value" style="color:#cc0000">0</div>
            <div class="stat-sub">Action requise</div>
        </div>
    </div>
    <div class="two-cols" style="margin-bottom:2rem">
        <div class="info-card">
            <h3>📡 Capacité Faisceaux Hertziens</h3>
            <div class="info-row">
                <span class="info-label">Capacité totale</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Trafic moyen</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Taux utilisation</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Marge disponible</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Sites > 90% charge</span>
                <span class="info-value" style="color:#cc0000">0</span>
            </div>
        </div>
        <div class="plan-card">
            <h3>📋 Plan d'action congestion</h3>
            <div class="plan-item">
                <div class="plan-num">1</div>
                <div class="plan-text">Identifier les liens saturés (trafic > seuil 90%)</div>
            </div>
            <div class="plan-item">
                <div class="plan-num">2</div>
                <div class="plan-text">Analyser la tendance sur 7 jours glissants</div>
            </div>
            <div class="plan-item">
                <div class="plan-num">3</div>
                <div class="plan-text">Proposer upgrade capacité ou rerouting trafic</div>
            </div>
            <div class="plan-item">
                <div class="plan-num">4</div>
                <div class="plan-text">Soumettre bon de travaux au département GC</div>
            </div>
            <div class="plan-item">
                <div class="plan-num">5</div>
                <div class="plan-text">Suivi et validation post-intervention</div>
            </div>
        </div>
    </div>
</div>
</body>
</html>