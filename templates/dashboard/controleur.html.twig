<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Dashboard Contrôleur — NetWON</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
            color: #333;
        }

        /* ========== SIDEBAR ========== */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            height: 100%;
            background: #1a1a2e;
            color: white;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 2rem;
        }

        .logo-circle {
            width: 42px;
            height: 42px;
            background: #FF6600;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: white;
            font-size: 18px;
        }

        .logo-text {
            color: white;
            font-size: 16px;
            font-weight: bold;
        }

        .logo-sub {
            color: #FF6600;
            font-size: 10px;
            font-style: italic;
        }

        .nav-section {
            font-size: 10px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 1.5rem 0 0.5rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.6rem 0.8rem;
            border-radius: 8px;
            color: #ccc;
            text-decoration: none;
            font-size: 13px;
            margin-bottom: 2px;
            transition: all 0.2s;
        }

        .nav-item:hover, .nav-item.active {
            background: #FF6600;
            color: white;
        }

        .logout-btn {
            margin-top: auto;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.6rem 0.8rem;
            border-radius: 8px;
            color: #ccc;
            text-decoration: none;
            font-size: 13px;
            transition: all 0.2s;
        }

        .logout-btn:hover {
            background: #cc0000;
            color: white;
        }

        /* ========== MAIN CONTENT ========== */
        .main {
            margin-left: 250px;
            padding: 2rem;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .topbar h1 {
            font-size: 20px;
            font-weight: 500;
            color: #333;
        }

        .user-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            background: white;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            border: 1px solid #eee;
            font-size: 13px;
            color: #555;
        }

        .avatar {
            width: 32px;
            height: 32px;
            background: #FF6600;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 600;
        }

        .role-badge {
            background: #FF6600;
            color: white;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 500;
        }

        /* Flash messages */
        .flash-success {
            background: #d4edda;
            color: #155724;
            padding: 12px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            border-left: 4px solid #28a745;
        }

        /* Stats grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            border-radius: 10px;
            padding: 1.2rem;
            border: 1px solid #eee;
            transition: transform 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-3px);
        }

        .stat-label {
            font-size: 12px;
            color: #888;
            margin-bottom: 6px;
        }

        .stat-value {
            font-size: 26px;
            font-weight: 600;
            color: #333;
        }

        .stat-sub {
            font-size: 11px;
            color: #aaa;
            margin-top: 4px;
        }

        /* Sections */
        .section-title {
            font-size: 14px;
            font-weight: 600;
            color: #333;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #FF6600;
            display: inline-block;
        }

        /* Cartes des sites */
        .sites-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .site-card {
            background: white;
            border-radius: 10px;
            padding: 1.2rem;
            border: 1px solid #eee;
            border-left: 4px solid;
        }

        .site-card.critique {
            border-left-color: #e74c3c;
            background: #fff5f5;
        }

        .site-card.warning {
            border-left-color: #FF6600;
        }

        .site-card.ok {
            border-left-color: #27ae60;
        }

        .site-name {
            font-size: 1rem;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .site-type {
            font-size: 0.7rem;
            padding: 3px 8px;
            border-radius: 12px;
            display: inline-block;
            margin-bottom: 10px;
        }

        .type-FO { background: #e74c3c; color: white; }
        .type-FH { background: #FF6600; color: white; }
        .type-BACKBONE { background: #9b59b6; color: white; }

        .site-info {
            font-size: 0.8rem;
            color: #555;
            margin: 8px 0;
        }

        /* Tableau tickets */
        .tickets-table {
            background: white;
            border-radius: 10px;
            border: 1px solid #eee;
            overflow: hidden;
        }

        .table-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            font-size: 11px;
            color: #888;
            font-weight: 500;
            padding: 0.75rem 1.5rem;
            background: #fafafa;
            border-bottom: 1px solid #eee;
        }

        td {
            padding: 0.85rem 1.5rem;
            font-size: 13px;
            color: #333;
            border-bottom: 1px solid #f5f5f5;
        }

        .ticket-status {
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 500;
            display: inline-block;
        }

        .status-en-cours { background: #fff3e0; color: #FF6600; }
        .status-en-retard { background: #ffe6e6; color: #cc0000; }
        .status-cloture { background: #e6ffe6; color: #006600; }

        .workflow-step {
            font-size: 0.75rem;
            color: #888;
        }

        .btn-detail {
            background: #FF6600;
            color: white;
            padding: 5px 12px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 11px;
            border: none;
            cursor: pointer;
        }

        .btn-detail:hover {
            background: #cc5200;
        }

        /* Alertes */
        .alert-item {
            background: #fff5f0;
            border-left: 3px solid #FF6600;
            padding: 12px;
            margin-bottom: 10px;
            border-radius: 8px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .sidebar {
                width: 70px;
                padding: 1rem;
            }
            .logo-text, .logo-sub, .nav-section, .nav-item span:not(:first-child) {
                display: none;
            }
            .main {
                margin-left: 70px;
            }
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>

<div class="sidebar">
    <div class="logo">
        <div class="logo-circle">
            <img src="{{ asset('images/logo.jpeg') }}" alt="NetWON" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
        </div>
        <div>
            <div class="logo-text">NetWON</div>
            <div class="logo-sub">You Don't Save Time. You WON It</div>
        </div>
    </div>
    <span class="nav-section">Supervision</span>
    <a href="{{ path('controleur_dashboard') }}" class="nav-item active">
        📊 Dashboard
    </a>
    <a href="{{ path('controleur_sites') }}" class="nav-item">
        📡 État des sites
    </a>
    <a href="{{ path('controleur_tickets') }}" class="nav-item">
        🎫 Tickets
    </a>
    <a href="{{ path('controleur_workflows') }}" class="nav-item">
        🔄 Workflows
    </a>
    
    <span class="nav-section">Reporting</span>
    <a href="{{ path('controleur_rapports') }}" class="nav-item">
        📊 Rapports
    </a>
    
    <a href="{{ path('app_logout') }}" class="logout-btn">
        🚪 Déconnexion
    </a>
</div>

<div class="main">
    <div class="topbar">
        <h1>Dashboard Contrôleur</h1>
        <div class="user-badge">
            <div class="avatar">C</div>
           
            {{ user.fullName ?? user.email ?? 'Contrôleur' }}
        </div>
    </div>

    {% for msg in app.flashes('success') %}
        <div class="flash-success">✅ {{ msg }}</div>
    {% endfor %}

    <!-- STATS : Supervision uniquement -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">📋 Total Tickets</div>
            <div class="stat-value">{{ totalTickets|default(0) }}</div>
            <div class="stat-sub">Tous tickets confondus</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">🟡 En cours</div>
            <div class="stat-value" style="color:#FF6600">{{ ticketsEnCours|default(0) }}</div>
            <div class="stat-sub">Tickets en traitement</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">🔴 En retard</div>
            <div class="stat-value" style="color:#cc0000">{{ ticketsEnRetard|default(0) }}</div>
            <div class="stat-sub">Délai dépassé</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">✅ Clôturés</div>
            <div class="stat-value" style="color:#27ae60">{{ ticketsClotures|default(0) }}</div>
            <div class="stat-sub">Ce mois</div>
        </div>
    </div>

    <!-- SITES CRITIQUES (Lecture seule) -->
    <div class="section-title">📡 Sites critiques</div>
    <div class="sites-grid">
        {% for site in sitesCritiques|default([]) %}
            <div class="site-card critique">
                <div class="site-name">📍 {{ site.nom }}</div>
                <div class="site-type type-{{ site.typeLiaison }}">{{ site.typeLiaison }}</div>
                <div class="site-info">📊 Taux utilisation: {{ site.tauxUtilisation }}%</div>
                <div class="site-info">⚠️ Seuil: {{ site.seuil }}%</div>
                <div class="site-info">📅 Dernière alerte: {{ site.derniereAlerte|date('d/m/Y H:i') }}</div>
            </div>
        {% else %}
            <div class="stat-card" style="text-align:center; color:#27ae60;">
                ✅ Aucun site critique actuellement
            </div>
        {% endfor %}
    </div>

    <!-- APERÇU DES TICKETS -->
    <div class="section-title">🎫 Aperçu des tickets</div>
    <div class="tickets-table">
        <div class="table-header">
            <span style="font-size:14px; font-weight:500;">Derniers tickets</span>
            <a href="{{ path('controleur_tickets') }}" class="btn-detail">Voir tous →</a>
        </div>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Site</th>
                    <th>Statut</th>
                    <th>Étape workflow</th>
                    <th>Équipe</th>
                    <th>Date création</th>
                </tr>
            </thead>
            <tbody>
                {% for ticket in ticketsRecents|default([]) %}
                <tr>
                    <td>#{{ ticket.id }}</td>
                    <td>{{ ticket.titre }}</td>
                    <td>{{ ticket.siteNom }}</td>
                    <td>
                        <span class="ticket-status status-{{ ticket.statut|lower|replace({' ':'-'}) }}">
                            {{ ticket.statut }}
                        </span>
                    </td>
                    <td class="workflow-step">{{ ticket.etapeWorkflow }}</td>
                    <td>{{ ticket.equipeResponsable }}</td>
                    <td>{{ ticket.dateCreation|date('d/m/Y') }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" style="text-align:center; color:#aaa; padding:2rem;">Aucun ticket pour le moment</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- WORKFLOWS EN COURS -->
    <div class="section-title" style="margin-top: 25px;">🔄 Workflows en cours</div>
    <div class="tickets-table">
        <div class="table-header">
            <span style="font-size:14px; font-weight:500;">Workflows actifs</span>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Site</th>
                    <th>Action</th>
                    <th>Étape actuelle</th>
                    <th>Équipe responsable</th>
                    <th>Date début</th>
                    <th>Date prévue fin</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for workflow in workflowsEnCours|default([]) %}
                <tr>
                    <td>{{ workflow.siteNom }}</td>
                    <td>{{ workflow.action }}</td>
                    <td>{{ workflow.etape }}</td>
                    <td>{{ workflow.equipe }}</td>
                    <td>{{ workflow.dateDebut|date('d/m/Y') }}</td>
                    <td>{{ workflow.dateFinPrevue|date('d/m/Y') }}</td>
                    <td>
                        {% if workflow.estEnRetard %}
                            <span class="ticket-status status-en-retard">⚠️ En retard</span>
                        {% else %}
                            <span class="ticket-status status-en-cours">🔄 En cours</span>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" style="text-align:center; color:#aaa; padding:2rem;">Aucun workflow actif</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- ALERTES RÉCENTES -->
    <div class="section-title" style="margin-top: 25px;">🔔 Alertes récentes</div>
    <div style="background: white; border-radius: 10px; border: 1px solid #eee; padding: 1.5rem;">
        {% for alerte in alertesRecentes|default([]) %}
        <div class="alert-item">
            <strong>⚠️ {{ alerte.type }}</strong> - {{ alerte.message }}
            <span style="float: right; font-size: 0.7rem; color: #aaa;">{{ alerte.date|date('d/m/Y H:i') }}</span>
        </div>
        {% else %}
        <div style="text-align:center; color:#27ae60; padding: 20px;">
            ✅ Aucune alerte récente
        </div>
        {% endfor %}
    </div>
</div>

</body>
</html>