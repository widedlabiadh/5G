<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Dashboard Déploiement — Orange Tunisie</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f5f5f5; }
        .sidebar {
            width: 250px; background: #1a1a2e; height: 100vh;
            position: fixed; left: 0; top: 0;
            display: flex; flex-direction: column; padding: 1.5rem;
        }
        .logo { display: flex; align-items: center; gap: 12px; margin-bottom: 2rem; }
        .logo-circle {
            width: 42px; height: 42px; background: #FF6600;
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; font-weight: 700; color: white; font-size: 18px;
        }
        .logo-text { color: white; font-size: 14px; font-weight: 500; }
        .logo-sub { color: #aaa; font-size: 11px; }
        .nav-section {
            font-size: 10px; color: #666;
            text-transform: uppercase; letter-spacing: 1px;
            margin: 1.5rem 0 0.5rem;
        }
        .nav-item {
            display: flex; align-items: center; gap: 10px;
            padding: 0.6rem 0.8rem; border-radius: 8px;
            color: #ccc; text-decoration: none; font-size: 13px;
            margin-bottom: 2px; transition: all 0.2s;
        }
        .nav-item:hover, .nav-item.active { background: #FF6600; color: white; }
        .main { margin-left: 250px; padding: 2rem; }
        .topbar {
            display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 2rem;
        }
        .topbar h1 { font-size: 20px; font-weight: 500; color: #333; }
        .user-badge {
            display: flex; align-items: center; gap: 10px;
            background: white; padding: 0.5rem 1rem;
            border-radius: 20px; border: 1px solid #eee;
            font-size: 13px; color: #555;
        }
        .avatar {
            width: 32px; height: 32px; background: #cc0000;
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; color: white; font-size: 11px; font-weight: 600;
        }
        .stats-grid {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 16px; margin-bottom: 2rem;
        }
        .stat-card {
            background: white; border-radius: 10px;
            padding: 1.2rem; border: 1px solid #eee;
        }
        .stat-label { font-size: 12px; color: #888; margin-bottom: 6px; }
        .stat-value { font-size: 26px; font-weight: 600; color: #333; }
        .stat-sub { font-size: 11px; color: #aaa; margin-top: 4px; }
        .two-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .info-card {
            background: white; border-radius: 10px;
            border: 1px solid #eee; padding: 1.5rem;
            border-top: 4px solid #cc0000;
        }
        .info-card h3 { font-size: 14px; font-weight: 500; color: #333; margin-bottom: 1rem; }
        .info-row {
            display: flex; justify-content: space-between;
            padding: 0.5rem 0; border-bottom: 1px solid #f5f5f5; font-size: 13px;
        }
        .info-row:last-child { border-bottom: none; }
        .info-label { color: #888; }
        .info-value { font-weight: 500; color: #333; }
        .sites-card {
            background: white; border-radius: 10px;
            border: 1px solid #eee; margin-top: 1.5rem; overflow: hidden;
        }
        .sites-header {
            padding: 1rem 1.5rem; border-bottom: 1px solid #eee;
            font-size: 14px; font-weight: 500; color: #333;
        }
        table { width: 100%; border-collapse: collapse; }
        th {
            text-align: left; font-size: 11px; color: #888;
            font-weight: 500; padding: 0.75rem 1.5rem;
            background: #fafafa; border-bottom: 1px solid #eee;
        }
        td {
            padding: 0.85rem 1.5rem; font-size: 13px;
            color: #333; border-bottom: 1px solid #f5f5f5;
        }
        .phase-badge {
            padding: 3px 10px; border-radius: 20px;
            font-size: 11px; font-weight: 500;
        }
        .phase-study { background: #e6f0ff; color: #0066cc; }
        .phase-deploy { background: #fff3e0; color: #FF6600; }
        .phase-done { background: #e6ffe6; color: #006600; }
        .logout-btn {
            margin-top: auto; display: flex; align-items: center; gap: 10px;
            padding: 0.6rem 0.8rem; border-radius: 8px;
            color: #ccc; text-decoration: none; font-size: 13px; transition: all 0.2s;
        }
        .logout-btn:hover { background: #cc0000; color: white; }
    </style>
</head>
<body>
<div class="sidebar">
    <div class="logo">
        <div class="logo-circle">O</div>
        <div>
            <div class="logo-text">Orange Tunisie</div>
            <div class="logo-sub">Transmission Monitor</div>
        </div>
    </div>
    <span class="nav-section">Déploiement</span>
    <a href="#" class="nav-item active">🏠 Dashboard</a>
    <a href="#" class="nav-item">🗺️ Sites 5G</a>
    <a href="#" class="nav-item">📋 Planning</a>
    <span class="nav-section">Phases</span>
    <a href="#" class="nav-item">🔍 Étude</a>
    <a href="#" class="nav-item">🚀 Déploiement</a>
    <a href="#" class="nav-item">✅ Mise en service</a>
    <span class="nav-section">Rapports</span>
    <a href="#" class="nav-item">📅 Hebdomadaire</a>
    <a href="#" class="nav-item">📅 Mensuel</a>
    <a href="{{ path('app_logout') }}" class="logout-btn">🚪 Déconnexion</a>
</div>
<div class="main">
    <div class="topbar">
        <h1>Dashboard Déploiement 5G</h1>
        <div class="user-badge">
            <div class="avatar">5G</div>
            {{ user.fullName ?? user.email }} 
        </div>
    </div>
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Sites 5G total</div>
            <div class="stat-value">0</div>
            <div class="stat-sub">En portefeuille</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">En déploiement</div>
            <div class="stat-value" style="color:#FF6600">0</div>
            <div class="stat-sub">Actifs</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Mis en service</div>
            <div class="stat-value" style="color:#00cc66">0</div>
            <div class="stat-sub">Ce mois</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">En étude</div>
            <div class="stat-value" style="color:#0066cc">0</div>
            <div class="stat-sub">Planifiés</div>
        </div>
    </div>
    <div class="two-cols">
        <div class="info-card">
            <h3>📡 Transmission requise</h3>
            <div class="info-row">
                <span class="info-label">Sites nécessitant FO</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Sites nécessitant FH</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Capacité requise 5G</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Impact trafic estimé</span>
                <span class="info-value">—</span>
            </div>
        </div>
        <div class="info-card">
            <h3>🚀 Avancement déploiement</h3>
            <div class="info-row">
                <span class="info-label">Taux avancement</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Sites en retard</span>
                <span class="info-value" style="color:#cc0000">0</span>
            </div>
            <div class="info-row">
                <span class="info-label">Prochaine livraison</span>
                <span class="info-value">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Objectif mensuel</span>
                <span class="info-value">—</span>
            </div>
        </div>
    </div>
    <div class="sites-card">
        <div class="sites-header">Sites 5G en cours de déploiement</div>
        <table>
            <thead>
                <tr>
                    <th>Site</th>
                    <th>Région</th>
                    <th>Type transmission</th>
                    <th>Phase</th>
                    <th>Date prévue</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="5" style="text-align:center; color:#aaa; padding:2rem;">
                        Aucun site en déploiement pour le moment
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
</body>
</html>