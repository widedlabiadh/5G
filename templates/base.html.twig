<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}NetWON{% endblock %}</title>
    {# Appliquer le thème avant le rendu pour éviter le flash #}
    <script>(function(){var t=localStorage.getItem('netwon_theme')||'light';var l=localStorage.getItem('netwon_lang')||'fr';document.documentElement.setAttribute('data-theme',t);document.documentElement.setAttribute('lang',l);}());</script>
    {# CSS globaux #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    {# CSS propres au projet (versionnés) #}
    <link rel="stylesheet" href="{{ asset('css/app.css') }}?v=chat-widget-1">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="page-scroll-progress" id="pageScrollProgress" aria-hidden="true"></div>

    <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Ouvrir le menu">
        <i class="fas fa-bars"></i>
    </button>
    <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>
    {# Sidebar latérale (incluse) #}
    <div class="sidebar">
        {% include 'layout/sidebar.html.twig' %}
    </div>

    {% if app.user %}
        {% include 'components/_navbar.html.twig' %}
    {% endif %}

    <div class="main">
        {# Messages flash #}
        {% include 'layout/flash_messages.html.twig' %}

        {# Contenu principal propre à chaque page #}
        {% block body %}{% endblock %}
    </div>

    <button type="button" class="back-to-top" id="backToTop" aria-label="Retour en haut">
        <i class="fas fa-arrow-up"></i>
    </button>

    {# Widget chatbot flottant (tous les rôles sauf admin) #}
    {% if app.user %}
        {% include 'layout/chat_widget.html.twig' %}
    {% endif %}

    {# Scripts globaux #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('js/app.js') }}?v=session-guard-fix-1"></script>
    <script src="{{ asset('js/settings.js') }}?v=1"></script>
    {% if app.user %}
        <script src="{{ asset('js/navbar.js') }}?v=ticket-notifications-1"></script>
    {% endif %}
    {% block javascripts %}{% endblock %}
</body>
</html>
