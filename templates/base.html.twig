<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}NetWON{% endblock %}</title>
    {# CSS globaux #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    {# CSS propres au projet (versionnés) #}
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Sidebar latérale (incluse) #}
    <div class="sidebar">
        {% include 'layout/sidebar.html.twig' %}
    </div>

    <div class="main">
        {# Messages flash #}
        {% include 'layout/flash_messages.html.twig' %}

        {# Contenu principal propre à chaque page #}
        {% block body %}{% endblock %}
    </div>

    {# Scripts globaux #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('js/app.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>