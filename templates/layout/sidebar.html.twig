{# templates/layout/sidebar.html.twig #}

<a href="{{ path('app_dashboard') }}" class="logo">
    <img src="{{ asset('images/logo.jpeg') }}" class="logo-img" alt="NetWON">
    <div class="logo-content">
        <div class="logo-text">NetWON</div>
        <div class="logo-sub">You Don't Save Time. You WON It</div>
    </div>
</a>

{% if is_granted('ROLE_SUPERUSER') %}
    <span class="nav-section" data-i18n="network">Réseau</span>
    <a href="{{ path('app_dashboard') }}" class="nav-item {% if app.request.get('_route') == 'app_dashboard' %}active{% endif %}">
        <i class="fas fa-gauge-high"></i> <span data-i18n="dashboard">Dashboard</span>
    </a>
    <a href="{{ path('courbe_trafic') }}" class="nav-item {% if 'courbe' in app.request.get('_route') %}active{% endif %}">
        <i class="fas fa-chart-line"></i> <span data-i18n="traffic_charts">Courbes Trafic</span>
    </a>
    <span class="nav-section" data-i18n="interfaces">Interfaces</span>
    <a href="{{ path('superuser_fo') }}" class="nav-item {% if app.request.get('_route') == 'superuser_fo' %}active{% endif %}">
        <i class="fas fa-circle-nodes" style="color:#0e7490;"></i> <span data-i18n="fiber">Fibre Optique</span>
    </a>
    <a href="{{ path('superuser_fh') }}" class="nav-item {% if app.request.get('_route') == 'superuser_fh' %}active{% endif %}">
        <i class="fas fa-tower-broadcast" style="color:#ff6200;"></i> <span data-i18n="microwave">Faisceaux Hertziens</span>
    </a>
    <a href="{{ path('superuser_backbone') }}" class="nav-item {% if app.request.get('_route') == 'superuser_backbone' %}active{% endif %}">
        <i class="fas fa-network-wired" style="color:#7c3aed;"></i> <span data-i18n="backhaul">Backhaul Sharing</span>
    </a>
    <a href="{{ path('superuser_tous') }}" class="nav-item {% if app.request.get('_route') == 'superuser_tous' %}active{% endif %}">
        <i class="fas fa-table-list"></i> <span data-i18n="all_sites">Tous les sites</span>
    </a>
    <a href="{{ path('superuser_dropcong') }}" class="nav-item {% if app.request.get('_route') == 'superuser_dropcong' %}active{% endif %}">
        <i class="fas fa-triangle-exclamation"></i> <span data-i18n="dropcong">DropCong</span>
    </a>
    <a href="{{ path('superuser_sites_index') }}" class="nav-item {% if app.request.get('_route') starts with 'superuser_sites' %}active{% endif %}">
        <i class="fas fa-sitemap"></i> <span data-i18n="site_mgmt">Gestion des sites</span>
    </a>
    <span class="nav-section" data-i18n="import_section">Import</span>
    <a href="{{ path('import_excel') }}" class="nav-item {% if 'import' in app.request.get('_route') %}active{% endif %}">
        <i class="fas fa-file-arrow-up"></i> <span data-i18n="plan_data">Plan Data</span>
    </a>
    <a href="{{ path('import_capacite') }}" class="nav-item">
        <i class="fas fa-bolt"></i> <span data-i18n="import_capacity">Import Capacité</span>
    </a>
    <a href="{{ path('import_umpt') }}" class="nav-item {% if app.request.get('_route') starts with 'import_umpt' %}active{% endif %}">
        <i class="fas fa-microchip"></i> <span data-i18n="import_umpt">Import UMPT</span>
    </a>
    <span class="nav-section" data-i18n="workflow_section">Workflow</span>
    <a href="{{ path('workflow_index') }}" class="nav-item {% if 'workflow' in app.request.get('_route') %}active{% endif %}">
        <i class="fas fa-ticket"></i> <span data-i18n="tickets_tasks">Tickets & Tâches</span>
    </a>

{% elseif is_granted('ROLE_ADMIN') %}
    <span class="nav-section" data-i18n="admin_section">Administration</span>
    <a href="{{ path('app_dashboard') }}" class="nav-item {% if app.request.get('_route') == 'app_dashboard' %}active{% endif %}">
        <i class="fas fa-gauge-high"></i> <span data-i18n="dashboard">Dashboard</span>
    </a>
    <a href="{{ path('admin_users') }}" class="nav-item {% if 'admin' in app.request.get('_route') %}active{% endif %}">
        <i class="fas fa-users"></i> <span data-i18n="user_mgmt">Gestion Utilisateurs</span>
    </a>
    <a href="{{ path('import_excel') }}" class="nav-item">
        <i class="fas fa-file-arrow-up"></i> <span data-i18n="import_excel">Import Excel</span>
    </a>
    <a href="{{ path('workflow_index') }}" class="nav-item">
        <i class="fas fa-ticket"></i> <span data-i18n="tickets_tasks">Tickets & Tâches</span>
    </a>

{% elseif is_granted('ROLE_CONTROLEUR') %}
    <span class="nav-section" data-i18n="support_section">Support</span>
    <a href="{{ path('app_dashboard') }}" class="nav-item {% if app.request.get('_route') == 'app_dashboard' %}active{% endif %}">
        <i class="fas fa-gauge-high"></i> <span data-i18n="dashboard">Dashboard</span>
    </a>
    <a href="{{ path('team_workflow_index') }}" class="nav-item {% if app.request.get('_route') starts with 'team_workflow' %}active{% endif %}">
        <i class="fas fa-ticket"></i> <span data-i18n="my_tickets">Mes Tickets</span>
    </a>
    <span class="nav-section">Rapports</span>
    <a href="{{ path('controleur_rapport') }}" class="nav-item {% if app.request.get('_route') == 'controleur_rapport' %}active{% endif %}">
        <i class="fas fa-file-chart-pie" style="color:#ff6200;"></i>
        <span>Rapport IA</span>
        <span style="margin-left:auto;background:#fff7ed;color:#ff6200;border:1px solid #fed7aa;border-radius:999px;font-size:.6rem;font-weight:800;padding:2px 7px;">PDF · XLS</span>
    </a>

{% elseif is_granted('ROLE_SUPPORT_FO') or is_granted('ROLE_SUPPORT_FH') or is_granted('ROLE_SUPPORT_RADIO') or is_granted('ROLE_INGENIERIE_FH') or is_granted('ROLE_INGENIERIE_IP') or is_granted('ROLE_GC') or is_granted('ROLE_DEPLOIEMENT') %}
    <span class="nav-section" data-i18n="my_tasks_section">Mes tâches</span>
    <a href="{{ path('app_dashboard') }}" class="nav-item active">
        <i class="fas fa-gauge-high"></i> <span data-i18n="dashboard">Dashboard</span>
    </a>
    <a href="{{ path('team_workflow_index') }}" class="nav-item {% if app.request.get('_route') starts with 'team_workflow' %}active{% endif %}">
        <i class="fas fa-ticket"></i> <span data-i18n="assigned_tickets">Tickets Assignés</span>
    </a>

{% endif %}

{# ── Paramètres (visible pour tous) ── #}
<div class="sidebar-settings-wrapper">
    <button type="button" class="settings-trigger" id="settingsTrigger" aria-expanded="false">
        <i class="fas fa-gear"></i>
        <span data-i18n="settings">Paramètres</span>
    </button>
    <div class="settings-panel" id="settingsPanel" hidden>
        <div class="settings-row">
            <span class="settings-label" data-i18n="theme_label">Thème</span>
            <div class="settings-toggle-group">
                <button type="button" class="settings-toggle-btn" data-theme-btn="light">
                    <i class="fas fa-sun"></i> <span data-i18n="theme_light">Clair</span>
                </button>
                <button type="button" class="settings-toggle-btn" data-theme-btn="dark">
                    <i class="fas fa-moon"></i> <span data-i18n="theme_dark">Sombre</span>
                </button>
            </div>
        </div>
        <div class="settings-row">
            <span class="settings-label" data-i18n="lang_label">Langue</span>
            <div class="settings-toggle-group">
                <button type="button" class="settings-toggle-btn" data-lang-btn="fr">
                    FR
                </button>
                <button type="button" class="settings-toggle-btn" data-lang-btn="en">
                    EN
                </button>
            </div>
        </div>
    </div>
</div>

<div class="sidebar-footer">
    <a href="{{ path('app_logout') }}" class="logout-btn">
        <i class="fas fa-arrow-right-from-bracket"></i>
        <span data-i18n="logout">Déconnexion</span>
    </a>
    <div class="brand-powered">
        <span>Powered by</span>
        <img src="{{ asset('images/orange-logo.png') }}" alt="Orange">
    </div>
</div>
